# Team password for the dashboard (required in production)
DASHBOARD_PASSWORD=
# Optional: signs the login cookie (defaults to one derived from the password)
SESSION_SECRET=

# Data: Soundcharts API (leave empty to run on simulated data)
SOUNDCHARTS_APP_ID=
SOUNDCHARTS_API_KEY=

# Storage: Supabase/Postgres connection string (leave empty for a local JSON file)
DATABASE_URL=

# Email: Resend
RESEND_API_KEY=
ALERT_FROM="TMWRK Alerts <alerts@yourdomain.com>"
ALERT_TO=team@tmwrk.example,manager@tmwrk.example
APP_URL=https://alerts.tmwrk.example

# Vercel Cron sends this as a bearer token to /api/cron
CRON_SECRET=
