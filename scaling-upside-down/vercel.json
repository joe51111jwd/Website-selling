{
  "rewrites": [
    { "source": "/appendix", "destination": "/index.html" },
    { "source": "/bootloader.txt", "destination": "/bootloader.md" }
  ],
  "headers": [
    { "source": "/frames/(.*).bin", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/frames/(.*)/manifest.json", "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }] },
    { "source": "/bootloader.md", "headers": [{ "key": "Content-Type", "value": "text/markdown; charset=utf-8" }, { "key": "Cache-Control", "value": "public, max-age=300" }] },
    { "source": "/bootloader.txt", "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }, { "key": "Cache-Control", "value": "public, max-age=300" }] },
    { "source": "/flatlay/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ]
}
