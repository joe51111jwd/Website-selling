---
import Base from '../layouts/Base.astro';
import PaperHome from '../components/home/PaperHome.astro';
import HomeDeck from '../components/deck/HomeDeck.astro';
import { getServices } from '../lib/content';
import { site } from '../site.config';
import { glass } from '../theme';

const services = await getServices();

const offers = services.map((s) => ({
  '@type': 'Offer',
  name: s.data.title,
  description: s.data.youGet,
  url: `${site.url}/services#${s.id}`,
  priceCurrency: 'USD',
  ...(s.data.priceMin === s.data.priceMax
    ? { price: s.data.priceMin }
    : {
        priceSpecification: {
          '@type': 'PriceSpecification',
          priceCurrency: 'USD',
          minPrice: s.data.priceMin,
          maxPrice: s.data.priceMax,
        },
      }),
}));

const schema = [
  {
    '@type': 'ProfessionalService',
    '@id': `${site.url}/#practice`,
    name: `${site.name}, ${site.role}`,
    url: site.url,
    description: site.description,
    founder: { '@id': `${site.url}/#person` },
    areaServed: [
      { '@type': 'Country', name: 'United States' },
      { '@type': 'Country', name: 'United Kingdom' },
    ],
    audience: { '@type': 'BusinessAudience', audienceType: 'Pre-seed and seed-stage startup founders' },
    makesOffer: offers,
  },
];
---

<Base title={`${site.name} · ${site.role} for pre-seed and seed founders`} home schema={schema}>
  {glass ? <HomeDeck /> : <PaperHome />}
</Base>
