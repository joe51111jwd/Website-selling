---
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import TermSheet from '../components/TermSheet.astro';
import WorkIndex from '../components/WorkIndex.astro';
import Markup from '../components/Markup.astro';
import Ticker from '../components/Ticker.astro';
import NarrativeLab from '../components/NarrativeLab.astro';
import Pen from '../components/Pen.astro';
import { getServices, getWork, pad } from '../lib/content';
import { site } from '../site.config';

const services = await getServices();
const notes = await getWork('analysis');

const problems = [
  {
    title: 'There’s no thesis.',
    body: 'The slides are in the right order and nothing connects them. The investor finishes the deck knowing what you do, and not why it’s an investment.',
    fix: 'rewrite',
  },
  {
    title: 'The claims can’t be checked.',
    body: 'A top-down market size, “no direct competitors”, growth with no rate attached. Investors discount claims they can’t test, and everything near them.',
    fix: 'creation',
  },
  {
    title: 'The founder can’t defend it.',
    body: 'The deck says one thing and the answers in the meeting say another. The first hard question about an assumption decides how the rest of the hour goes.',
    fix: 'qa-prep',
  },
  {
    title: 'It goes to the wrong people.',
    body: 'A good story sent to investors who don’t back your stage, sector or geography gets a polite no that teaches you nothing.',
    fix: 'investor-research',
  },
];

const byId = Object.fromEntries(services.map((s) => [s.id, s]));

const principles = [
  {
    title: 'Thesis before slides.',
    body: 'Every engagement starts with the investment case written out in plain sentences. If it doesn’t hold up as a paragraph, no layout will rescue it.',
  },
  {
    title: 'Read it the way the investor will.',
    body: 'Investors aren’t asking whether the company is good. They’re asking what has to be true for it to be big, and whether you’ve shown it’s becoming true.',
  },
  {
    title: 'Every claim earns its place.',
    body: 'Market size from the bottom up. Traction as a rate, not a total. Competitors named honestly. A claim you can defend beats a bigger one you can’t.',
  },
  {
    title: 'You have to own it.',
    body: 'You’re the one in the room, so the story has to sound like you under questioning. You’ll understand the reasoning behind every slide.',
  },
];

const steps = [
  {
    title: 'Enquiry',
    body: 'Tell me about the company, the round and where the story feels weak. Share the deck if you have one.',
    h: 58,
  },
  {
    title: 'First read',
    body: 'I read everything myself and reply with a straight answer on whether I can help, which service fits, or whether you need me at all yet.',
    h: 70,
  },
  {
    title: 'The narrative',
    body: 'We agree the thesis in writing, then build or rebuild the storyline and the slides around it.',
    h: 84,
  },
  {
    title: 'The room',
    body: 'You go into meetings able to explain the company, and defend it. With Q&A preparation, you’ve rehearsed the hard questions first.',
    h: 100,
  },
];

// The statement that darkens word by word as it scrolls past. *Asterisks* mark the italic phrase.
const statement =
  'Investors don’t fund slides. They fund an argument they can repeat to their partners on *Monday morning.* My job is to find that argument in what you’ve built, make every claim in it defensible, and only then put it on slides.';
let inEm = false;
const words = statement.split(' ').map((raw) => {
  const opens = raw.startsWith('*');
  const closes = raw.endsWith('*') || raw.endsWith('*.');
  if (opens) inEm = true;
  const w = { text: raw.replace(/\*/g, ''), em: inEm };
  if (closes) inEm = false;
  return w;
});

const heroWords = ['Investors', 'fund', 'what', 'they', 'can'];

const offers = services.map((s) => ({
  '@type': 'Offer',
  name: s.data.title,
  description: s.data.youGet,
  url: `${site.url}/services#${s.id}`,
  priceCurrency: 'USD',
  ...(s.data.priceMin === s.data.priceMax
    ? { price: s.data.priceMin }
    : {
        priceSpecification: {
          '@type': 'PriceSpecification',
          priceCurrency: 'USD',
          minPrice: s.data.priceMin,
          maxPrice: s.data.priceMax,
        },
      }),
}));

const schema = [
  {
    '@type': 'ProfessionalService',
    '@id': `${site.url}/#practice`,
    name: `${site.name}, ${site.role}`,
    url: site.url,
    description: site.description,
    founder: { '@id': `${site.url}/#person` },
    areaServed: [
      { '@type': 'Country', name: 'United States' },
      { '@type': 'Country', name: 'United Kingdom' },
    ],
    audience: { '@type': 'BusinessAudience', audienceType: 'Pre-seed and seed-stage startup founders' },
    makesOffer: offers,
  },
];
---

<Base title={`${site.name} · ${site.role} for pre-seed and seed founders`} home schema={schema}>
  <!-- Front page -->
  <section class="hero wrap" aria-labelledby="hero-title">
    <div class="hero-grid">
      <div class="hero-main">
        <p class="kicker fade-in" style="--fd: 0.15s">For pre-seed and seed founders preparing to raise</p>
        <h1 id="hero-title" class="display h1 hero-title">
          {
            heroWords.map((w, i) => (
              <>
                <span class="rise">
                  <span style={`--i: ${i + 2}`}>{w}</span>
                </span>{' '}
              </>
            ))
          }
          <em
            ><span class="pen-wrap"
              ><span class="rise"><span style="--i: 7">explain</span></span><Pen kind="underline" load delay={1.05} /></span
            >{' '}
            <span class="rise"><span style="--i: 8">to</span></span>{' '}
            <span class="rise"><span style="--i: 9">someone</span></span>{' '}
            <span class="rise"><span style="--i: 10">else.</span></span></em
          >
        </h1>
        <p class="lead hero-lead fade-in" style="--fd: 0.75s">
          I help founders turn what they’ve built into an investment case that investors can follow, test and retell to
          their partners. The narrative comes first, then the deck.
        </p>
        <div class="btn-row hero-ctas fade-in" style="--fd: 0.9s">
          <a href="/work-with-me" class="btn" data-cta="Discuss your raise" data-cta-location="hero">
            Discuss your raise <span class="arrow" aria-hidden="true">→</span>
          </a>
          <a
            href="/work-with-me?type=audit"
            class="btn btn--ghost"
            data-cta="Request a free deck audit"
            data-cta-location="hero"
          >
            Request a free deck audit
          </a>
        </div>
      </div>

      <div class="hero-figure fade-in" style="--fd: 0.45s">
        <Markup />
      </div>
    </div>

    <nav class="hire fade-in" style="--fd: 1.1s" aria-labelledby="hire-title">
      <p class="caps hire-title" id="hire-title">What you can hire me for</p>
      <ol>
        {
          services.map((s, i) => (
            <li>
              <a href={`/services#${s.id}`}>
                <span class="hire-num figures">{pad(i + 1)}</span>
                <span class="hire-name">{s.data.title}</span>
                <span class="hire-price figures">{s.data.price}</span>
              </a>
            </li>
          ))
        }
        <li class="hire-audit">
          <a href="/work-with-me?type=audit" data-cta="Request a free deck audit" data-cta-location="hire strip">
            <span class="hire-num">+</span>
            <span class="hire-name">Deck mini-audit</span>
            <span class="hire-price">Complimentary</span>
          </a>
        </li>
      </ol>
    </nav>
  </section>

  <Ticker />

  <!-- § 01 The problem -->
  <section class="band-ink" aria-labelledby="problem-title">
    <div class="wrap section problem">
      <SectionHead num="01" label="The problem" id="problem-title">
        <Fragment slot="title">Most decks describe the company. <em>Few make the case for investing in it.</em></Fragment>
        <Fragment slot="lead">
          An investor reading your deck is asking one question: could this become big enough, fast enough, to matter to
          the fund? Twelve accurate slides in the standard order don’t answer it by themselves. When a raise stalls on
          the story, it’s usually for one of four reasons.
        </Fragment>
      </SectionHead>

      <ol class="reasons">
        {
          problems.map((p, i) => (
            <li class="reason" data-reveal style={`--rd: ${i * 0.1}s`}>
              <span class="reason-num figures" aria-hidden="true">
                {pad(i + 1)}
              </span>
              <h3 class="display reason-title">{p.title}</h3>
              <p>{p.body}</p>
              {byId[p.fix] && (
                <a href={`/services#${p.fix}`} class="reason-fix">
                  <span class="caps">Fixed by</span>
                  <span>
                    {byId[p.fix].data.title} <span aria-hidden="true">→</span>
                  </span>
                </a>
              )}
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- The short version -->
  <section class="wrap statement" aria-label="The short version">
    <p class="display statement-text" data-words>
      {
        words.map((w) => (
          <>
            <span class:list={['w', { 'w--em': w.em }]}>{w.text}</span>{' '}
          </>
        ))
      }
    </p>
  </section>

  <!-- § 02 Services, on the desk -->
  <section class="band-desk" aria-labelledby="services-title">
    <div class="wrap section">
      <SectionHead num="02" label="Services" id="services-title">
        <Fragment slot="title"
          >Four ways to work together. <em
            >Every price is <span class="pen-wrap">public.<Pen kind="circle" delay={0.6} /></span></em
          ></Fragment
        >
        <Fragment slot="lead">
          So you can decide whether this is worth a conversation without having one first. Each engagement starts from
          the investment case and ends with something you can take into your next meeting.
        </Fragment>
      </SectionHead>

      <div class="sheets">
        {services.map((s, i) => <TermSheet service={s} n={i + 1} />)}
      </div>

      <div class="audit-strip" data-reveal>
        <span class="tag audit-tag">Complimentary</span>
        <p class="audit-text">
          Already have a deck? Send it over and I’ll write back with the <em>three changes I’d make first.</em> A few each
          month, for founders raising pre-seed or seed in the next six months.
        </p>
        <a
          href="/work-with-me?type=audit"
          class="btn"
          data-cta="Request a free deck audit"
          data-cta-location="services strip"
        >
          Request a mini-audit <span class="arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- § 03 Before and after -->
  <section class="wrap section" aria-labelledby="lab-title">
    <SectionHead num="03" label="Before & after" id="lab-title">
      <Fragment slot="title">Drag across a slide. <em>See what changes.</em></Fragment>
      <Fragment slot="lead">
        Five slides that decide most first meetings, as they usually arrive and as they read after a rewrite. The
        examples are invented; the reasoning is the work.
      </Fragment>
    </SectionHead>
    <div data-reveal>
      <NarrativeLab entries={notes} />
    </div>
  </section>

  <!-- The line -->
  <section class="band-ox quote-band" aria-label="How I see it">
    <div class="wrap">
      <blockquote class="big-quote" data-inview>
        <p class="display">
          A pitch deck is a positioning problem <em
            >with a <span class="pen-wrap">different buyer.<Pen kind="underline" delay={0.5} /></span></em
          >
        </p>
        <footer class="quote-foot">
          <span class="caps">Raymond Ekpo</span>
          <a href="/about" class="quote-link">How I think about fundraising narratives →</a>
        </footer>
      </blockquote>
    </div>
  </section>

  <!-- § 04 Approach -->
  <section class="wrap section" aria-labelledby="approach-title">
    <SectionHead num="04" label="The approach" id="approach-title">
      <Fragment slot="title"
        ><span class="sr-only">Not a deck designer. </span><span aria-hidden="true" class="pen-wrap struck"
          >A deck designer.<Pen kind="strike" delay={0.5} /></span
        >{' '}<em>The thinking a deck is made of.</em></Fragment
      >
      <Fragment slot="lead">
        Design matters, but it’s the last step. The work that changes how investors see a company happens before
        anyone opens a slide template.
      </Fragment>
    </SectionHead>

    <ol class="principles">
      {
        principles.map((p, i) => (
          <li data-reveal style={`--rd: ${i * 0.08}s`}>
            <span class="principle-num">{['i', 'ii', 'iii', 'iv'][i]}.</span>
            <h3 class="display principle-title">{p.title}</h3>
            <p>{p.body}</p>
          </li>
        ))
      }
    </ol>

    <aside class="disclosure" data-reveal aria-labelledby="disclosure-title">
      <p class="disclosure-label caps" id="disclosure-title">Disclosure</p>
      <p class="disclosure-text">
        Nobody can promise you a raise, and I don’t. Whether a round closes depends on the company, the market and the
        timing. What the work does is make sure investors understand what you’re building and why it could matter.
        That’s the part of the outcome a narrative controls.
      </p>
    </aside>
  </section>

  <!-- § 05 Process -->
  <section class="wrap section" aria-labelledby="process-title">
    <SectionHead num="05" label="How it works" id="process-title">
      <Fragment slot="title">From first message <em>to the room.</em></Fragment>
    </SectionHead>

    <figure class="chart" data-inview>
      <ol class="steps">
        {
          steps.map((s, i) => (
            <li class="step" style={`--h: ${s.h}%; --n: ${i}`}>
              <span class="step-num figures">{pad(i + 1)}</span>
              <h3 class="display step-title">{s.title}</h3>
              <p>{s.body}</p>
            </li>
          ))
        }
      </ol>
      <svg class="trend" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
        <polyline points="12.5,44 37.5,33 62.5,21 87.5,7"></polyline>
      </svg>
      {
        [
          [12.5, 44],
          [37.5, 33],
          [62.5, 21],
          [87.5, 7],
        ].map(([x, y], i) => (
          <span class="trend-dot" style={`left: ${x}%; top: calc(${y} * 6px); --n: ${i}`} aria-hidden="true" />
        ))
      }
      <figcaption class="fig chart-fig"><b>Fig. 2</b> Readiness for the room, rising.</figcaption>
    </figure>
  </section>

  <!-- § 06 Notes -->
  <section class="band-ink" aria-labelledby="notes-title">
    <div class="wrap section">
      <SectionHead num="06" label="Notes & analyses" id="notes-title">
        <Fragment slot="title">How I think about <em>investor narratives.</em></Fragment>
        <Fragment slot="lead">
          Short analyses of the slides that decide most first meetings: what founders usually write, what investors
          hear, and what to write instead.
        </Fragment>
      </SectionHead>
      <WorkIndex entries={notes} dark />
      <p class="more">
        <a href="/work" class="more-link">All work <span class="arrow" aria-hidden="true">→</span></a>
      </p>
    </div>
  </section>

  <!-- § 07 Fit -->
  <section class="wrap section" aria-labelledby="fit-title">
    <SectionHead num="07" label="Fit" id="fit-title">
      <Fragment slot="title">Is this for you? <em>Here’s how to tell.</em></Fragment>
    </SectionHead>

    <div class="fit">
      <div class="fit-col" data-inview>
        <h3 class="fit-head">A good fit if</h3>
        <ul class="fit-list">
          {
            [
              'You’re raising a pre-seed or seed round, from US or UK investors, in the next few months.',
              'You have something real to point to, such as a product, early customers, a strong team or a sharp insight into a market.',
              'You have a deck that isn’t getting the response the company deserves, or you’re about to write your first.',
              'You want to understand the reasoning, not just receive slides.',
            ].map((t, i) => (
              <li>
                <span class="fit-mark">
                  <Pen kind="tick" delay={0.2 + i * 0.18} />
                </span>
                {t}
              </li>
            ))
          }
        </ul>
      </div>
      <div class="fit-col fit-col--no" data-inview>
        <h3 class="fit-head">Probably not a fit if</h3>
        <ul class="fit-list">
          {
            [
              'You want the slides made prettier and nothing else touched. A designer is better value for that.',
              'You need someone to guarantee a raise, or to make the numbers look bigger than they are.',
              'You’re raising a Series A or later. This work is built for the earliest rounds.',
              'You’re looking to buy introductions to investors.',
            ].map((t, i) => (
              <li>
                <span class="fit-mark">
                  <Pen kind="cross" delay={0.4 + i * 0.18} />
                </span>
                {t}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---------- Front page ---------- */
  .hero {
    padding-top: clamp(28px, 2.6vw, 40px);
  }

  .hero-grid {
    display: grid;
    gap: 44px;
    align-items: center;
  }

  @media (min-width: 1000px) {
    .hero-grid {
      grid-template-columns: minmax(0, 6.3fr) minmax(0, 5.7fr);
      gap: 32px;
    }
  }

  .hero-title {
    font-size: clamp(2.7rem, 5.3vw, 4.85rem);
    line-height: 0.96;
    letter-spacing: -0.03em;
  }

  .hero-title em {
    padding-right: 0.06em;
  }

  .rise {
    padding-right: 0.08em;
    margin-right: -0.08em;
  }

  .hero-lead {
    margin-top: clamp(20px, 2vw, 26px);
  }

  .hero-ctas {
    margin-top: clamp(24px, 2.4vw, 30px);
  }

  .hero-figure {
    --fd: 0.45s;
  }

  @media (min-width: 1000px) {
    .hero-figure {
      margin-right: calc(-1 * min(3vw, 40px));
    }
  }

  @media (max-width: 999px) {
    .hero-figure {
      max-width: 600px;
    }
  }

  /* The services index under the fold line, like a newspaper's contents strip */
  .hire {
    margin-top: clamp(40px, 5vw, 64px);
    border-top: 3px double var(--ink);
  }

  .hire-title {
    padding: 12px 0;
    color: var(--ink);
    border-bottom: 1px solid var(--rule);
  }

  .hire ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
  }

  @media (min-width: 700px) {
    .hire ol {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 1100px) {
    .hire ol {
      grid-template-columns: repeat(5, 1fr);
    }
    .hire li + li a {
      border-left: 1px solid var(--rule);
      padding-left: 20px;
    }
  }

  .hire a {
    display: grid;
    grid-template-columns: 2rem 1fr auto;
    gap: 4px 10px;
    align-items: baseline;
    height: 100%;
    padding: 16px 14px 16px 0;
    border-bottom: 1px solid var(--rule);
    color: var(--ink);
    text-decoration: none;
    transition: background-color 0.25s ease;
  }

  @media (min-width: 1100px) {
    .hire a {
      grid-template-columns: 1fr;
      padding: 18px 16px 20px 0;
      border-bottom: 0;
    }
  }

  .hire a:hover {
    background: var(--paper-deep);
  }

  .hire-num {
    font-family: var(--serif);
    font-style: italic;
    color: var(--oxblood);
  }

  .hire-name {
    font-family: var(--serif);
    font-size: 1.25rem;
    line-height: 1.15;
    letter-spacing: -0.01em;
  }

  .hire-price {
    font-size: 0.92rem;
    font-weight: 500;
    color: var(--text);
  }

  .hire-audit .hire-price {
    font-family: var(--serif);
    font-style: italic;
    color: var(--oxblood);
  }

  /* ---------- § 01 on ink ---------- */
  .reasons {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0;
  }

  @media (min-width: 700px) {
    .reasons {
      grid-template-columns: 1fr 1fr;
      row-gap: 48px;
    }
  }

  @media (min-width: 1100px) {
    .reasons {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .reason {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 28px 0;
    border-top: 1px solid rgb(244 239 230 / 0.16);
  }

  @media (min-width: 700px) {
    .reason {
      padding: 0 28px;
      border-top: 0;
      border-left: 1px solid rgb(244 239 230 / 0.16);
    }
    .reason:nth-child(odd) {
      border-left: 0;
      padding-left: 0;
    }
  }

  @media (min-width: 1100px) {
    .reason:nth-child(odd) {
      border-left: 1px solid rgb(244 239 230 / 0.16);
      padding-left: 28px;
    }
    .reason:first-child {
      border-left: 0;
      padding-left: 0;
    }
  }

  .reason-num {
    font-family: var(--serif);
    font-size: clamp(4.5rem, 8vw, 7.5rem);
    line-height: 0.85;
    letter-spacing: -0.04em;
    color: transparent;
    -webkit-text-stroke: 1px #e2a99b;
    margin-bottom: 8px;
  }

  .reason-title {
    font-size: clamp(1.45rem, 2vw, 1.75rem);
    line-height: 1.15;
    letter-spacing: -0.012em;
  }

  .reason-fix {
    margin-top: auto;
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-top: 16px;
    border-top: 1px solid rgb(244 239 230 / 0.16);
    color: var(--paper);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
  }

  .reason-fix .caps {
    color: rgb(244 239 230 / 0.5);
    font-size: 0.66rem;
  }

  .reason-fix:hover span:last-child {
    color: #e2a99b;
  }

  /* ---------- The statement ---------- */
  .statement {
    padding-block: clamp(96px, 13vw, 180px);
  }

  .statement-text {
    font-size: clamp(2rem, 4.5vw, 4.3rem);
    line-height: 1.1;
    letter-spacing: -0.026em;
    max-width: 19em;
  }

  /* Unread words stay legible (3:1 at this size); reading darkens them to ink. Without scripts they start dark. */
  .w {
    color: var(--ink);
    transition: color 0.35s ease;
  }

  :global(.js) .w {
    color: #8f8471;
  }

  :global(.js) .w.on {
    color: var(--ink);
  }

  .w.on {
    color: var(--ink);
  }

  .w--em {
    font-style: italic;
  }

  .w--em,
  :global(.js) .w--em.on {
    color: var(--oxblood);
  }

  /* ---------- § 02 on the desk ---------- */
  .sheets {
    display: grid;
    gap: 40px;
    padding: 18px 6px 0;
  }

  @media (min-width: 760px) {
    .sheets {
      grid-template-columns: 1fr 1fr;
      gap: 56px 44px;
    }
  }

  .audit-strip {
    display: grid;
    gap: 18px;
    justify-items: start;
    margin-top: clamp(56px, 7vw, 88px);
    padding: 28px 0;
    border-top: 1px solid var(--ink);
    border-bottom: 1px solid var(--ink);
  }

  @media (min-width: 900px) {
    .audit-strip {
      grid-template-columns: auto 1fr auto;
      align-items: center;
      gap: 32px;
    }
  }

  .audit-tag {
    color: var(--oxblood);
  }

  .audit-text {
    font-family: var(--serif);
    font-size: clamp(1.25rem, 1.8vw, 1.55rem);
