---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { site } from '../site.config';
import Pen from '../components/Pen.astro';
import Seal from '../components/Seal.astro';
import StackCards from '../components/StackCards.astro';

const beliefs = [
  {
    title: 'Investors are buyers too.',
    body: 'They’re buying a share of an outcome, and before they commit they have to explain it to someone else, whether that’s their partners, their co-investors or their own judgement. A narrative has to survive being retold without you in the room.',
  },
  {
    title: 'Clarity beats ambition.',
    body: 'A smaller claim you can defend earns more trust than a bigger one you can’t. Overclaiming is the quickest way for a deck to lose an investor’s confidence, and they’re trained to spot it.',
  },
  {
    title: 'The thinking comes first.',
    body: 'If the investment case can’t be written as a clear paragraph, layout won’t fix it. So I write before I design, and every slide has to earn its place in the argument.',
  },
];

const ways = [
  {
    title: 'I do the work myself.',
    body: 'The person who reads your enquiry is the person who writes your narrative, from start to finish.',
  },
  {
    title: 'In writing, wherever it helps.',
    body: 'A thesis you can read, forward and argue with is worth more than a call you have to remember. When a conversation would make the work better, we have one.',
  },
  {
    title: 'No promises I can’t keep.',
    body: 'Nobody can guarantee a raise. What I can do is make sure the investors you meet understand what you’re building and why it could matter.',
  },
];

const schema = [
  {
    '@type': 'ProfilePage',
    url: `${site.url}/about`,
    mainEntity: { '@id': `${site.url}/#person` },
  },
];
---

<Base
  title="About"
  description="Raymond Ekpo is an Investor Narrative Specialist who helps pre-seed and seed founders explain why their company is worth investing in. He also runs Maneuver & Co."
  schema={schema}
>
  <PageHead kicker="About">
    <Fragment slot="title"
      >I work on the part of a raise <em
        >that happens <span class="pen-wrap">before<Pen kind="underline" load delay={1} /></span> the slides.</em
      ></Fragment
    >
  </PageHead>

  <div class="wrap about">
    <aside class="byline" aria-label="Raymond Ekpo at a glance">
      {
        site.portrait ? (
          <img src={site.portrait} alt={site.name} class="portrait" width="640" height="800" />
        ) : (
          <div class="plate" aria-hidden="true">
            <Seal id="about" center="R.E." class="plate-seal" />
            <span class="plate-name display">Raymond Ekpo</span>
            <span class="plate-role caps">{site.role}</span>
          </div>
        )
      }
      <dl class="byline-facts">
        <div>
          <dt class="caps">Works with</dt>
          <dd>Pre-seed and seed founders</dd>
        </div>
        <div>
          <dt class="caps">Raising from</dt>
          <dd>US and UK investors</dd>
        </div>
        <div>
          <dt class="caps">Also</dt>
          <dd>Founder, <a href={site.firm.url} rel="noopener" target="_blank">{site.firm.name}</a></dd>
        </div>
      </dl>
      <ul class="byline-links">
        <li><a href={site.x.url} rel="me noopener" target="_blank" data-contact="x" class="link">X {site.x.handle}</a></li>
        <li><a href={site.linkedin} rel="me noopener" target="_blank" data-contact="linkedin" class="link">LinkedIn</a></li>
      </ul>
    </aside>

    <div class="prose about-prose">
      <p>
        I’m Raymond Ekpo. I help pre-seed and seed founders in the US and UK explain why their company is worth
        investing in: the thesis, the storyline, and the claims that hold it up.
      </p>

      <h2>Where this comes from</h2>
      <p>
        I spent several years studying how markets work, mostly by watching capable companies stall for reasons nobody
        inside them could name. That work became <a href={site.firm.url} rel="noopener" target="_blank"
          >{site.firm.name}</a
        >, the growth strategy firm I run. The job there is to establish what’s actually in the way and write it down in
        a form people can argue with.
      </p>
      <p>
        The same problem turns up at the very start of a company, in a different form. A founder knows the product, the
        customers and the market better than anyone, and still struggles to say why it’s an investment. That’s a
        different question from why it’s a good product.
      </p>
    </div>
  </div>

  <section class="band-ox quote" aria-label="The short version">
    <div class="wrap">
      <blockquote class="big-quote" data-inview>
        <p class="display">
          A pitch deck is a positioning problem <em
            >with a <span class="pen-wrap">different buyer.<Pen kind="underline" delay={0.5} /></span></em
          >
        </p>
      </blockquote>
    </div>
  </section>

  <section class="beliefs" aria-labelledby="beliefs-title">
    <div class="wrap">
      <p class="kicker"><span class="num">§</span> Beliefs</p>
      <h2 id="beliefs-title" class="display h2 beliefs-title">How I think about <em>fundraising narratives.</em></h2>
      <div class="belief-stack">
        <StackCards items={beliefs} label="Belief" />
      </div>
    </div>
  </section>

  <section class="wrap ways" aria-labelledby="ways-title">
    <p class="kicker"><span class="num">§</span> Practice</p>
    <h2 id="ways-title" class="display h2">How I <em>work.</em></h2>
    <ol class="way-list">
      {
        ways.map((w, i) => (
          <li data-reveal style={`--rd: ${i * 0.08}s`}>
            <span class="way-num">{['i', 'ii', 'iii'][i]}.</span>
            <h3 class="display way-title">{w.title}</h3>
            <p>{w.body}</p>
          </li>
        ))
      }
    </ol>
    <p class="about-next">
      <a href="/services" class="btn btn--ghost">See the services and prices <span class="arrow" aria-hidden="true">→</span></a>
    </p>
  </section>
</Base>

<style>
  .about {
    display: grid;
    gap: 56px;
  }

  @media (min-width: 1000px) {
    .about {
      grid-template-columns: 4fr 8fr;
      gap: 64px;
    }
    .about-prose {
      margin-left: calc(100% / 8);
    }
  }

  /* The byline plate: a sheet with the seal pressed into it */
  .plate {
    position: relative;
    display: grid;
    justify-items: center;
    align-content: center;
    gap: 14px;
    aspect-ratio: 4 / 5;
    max-width: 360px;
    padding: 28px;
    background: var(--sheet);
    color: var(--oxblood);
    transform: rotate(-1.4deg);
    box-shadow:
      0 1px 0 rgb(27 26 23 / 0.06),
      0 30px 54px -30px rgb(27 26 23 / 0.45);
  }

  .plate::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: repeating-linear-gradient(transparent 0 31px, rgb(122 34 34 / 0.045) 31px 32px);
    pointer-events: none;
  }

  .plate :global(.plate-seal) {
    position: relative;
    width: 62%;
    height: auto;
    aspect-ratio: 1;
    transform: rotate(-10deg);
    mix-blend-mode: multiply;
  }

  .plate-name {
    position: relative;
    margin-top: 10px;
    font-size: 1.9rem;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  .plate-role {
    position: relative;
    color: var(--oxblood);
  }

  .portrait {
    width: 100%;
    max-width: 360px;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    filter: grayscale(0.15);
  }

  @media (max-width: 999px) {
    .plate {
      aspect-ratio: auto;
      max-width: 420px;
      grid-template-columns: 96px 1fr;
      justify-items: start;
      align-items: center;
      gap: 4px 20px;
      padding: 22px;
    }
    .plate :global(.plate-seal) {
      width: 96px;
      grid-row: span 2;
    }
    .plate-name {
      margin-top: 0;
      align-self: end;
    }
    .plate-role {
      align-self: start;
    }
    .portrait {
      max-width: 200px;
    }
  }

  .byline-facts {
    margin: 28px 0 0;
    max-width: 360px;
    border-top: 3px double var(--ink);
  }

  .byline-facts > div {
    display: grid;
    grid-template-columns: 7.5rem 1fr;
    gap: 12px;
    padding: 12px 0;
    border-bottom: 1px solid var(--rule);
  }

  .byline-facts dt {
    color: var(--muted);
    padding-top: 0.25em;
  }

  .byline-facts dd {
    margin: 0;
    color: var(--ink);
    font-size: 0.98rem;
  }

  .byline-facts a {
    color: var(--oxblood);
  }

  .byline-links {
    list-style: none;
    margin: 20px 0 0;
    padding: 0;
    display: flex;
    gap: 24px;
  }

  .about-prose > p:first-child {
    font-family: var(--serif);
    font-size: clamp(1.5rem, 2.4vw, 2rem);
    line-height: 1.3;
    letter-spacing: -0.012em;
    color: var(--ink);
  }

  /* No drop cap on "I’m": the apostrophe would drop with it */
  .about-prose > p:first-child::first-letter {
    float: none;
    font: inherit;
    padding: 0;
    color: inherit;
  }

  .quote {
    margin-top: var(--section);
    padding-block: clamp(88px, 12vw, 168px);
  }

  .big-quote {
    margin: 0;
    --pen: #f4efe6;
  }

  .big-quote p {
    font-size: clamp(2.5rem, 6.6vw, 6.4rem);
    line-height: 1;
    letter-spacing: -0.035em;
    color: var(--paper);
    max-width: 13.5em;
  }

  .big-quote em {
    color: #f0cfc6;
  }

  .beliefs {
    padding-block: clamp(88px, 11vw, 152px);
  }

  .beliefs-title {
    max-width: 14em;
  }

  .belief-stack {
    margin-top: clamp(40px, 6vw, 72px);
  }

  .belief-list {
    list-style: none;
    margin: clamp(48px, 6vw, 80px) 0 0;
    padding: 0;
    display: grid;
  }

  @media (min-width: 900px) {
    .belief-list {
      grid-template-columns: repeat(3, 1fr);
    }
    .belief-list li + li {
      border-left: 1px solid rgb(244 239 230 / 0.16);
      padding-left: 32px;
    }
    .belief-list li {
      padding-right: 32px;
    }
  }

  .belief-list li {
    display: grid;
    align-content: start;
    gap: 14px;
    padding-block: 24px;
    border-top: 1px solid rgb(244 239 230 / 0.16);
  }

  @media (min-width: 900px) {
    .belief-list li {
      border-top: 0;
    }
  }

  .belief-num {
    font-family: var(--serif);
    font-size: clamp(4.5rem, 8vw, 7.5rem);
    line-height: 0.85;
    letter-spacing: -0.04em;
    color: transparent;
    -webkit-text-stroke: 1px #e2a99b;
  }

  .belief-title {
    font-size: clamp(1.6rem, 2.3vw, 2rem);
    line-height: 1.12;
    letter-spacing: -0.016em;
  }

  .ways {
    padding-top: var(--section);
  }

  .way-list {
    list-style: none;
    margin: clamp(40px, 5vw, 64px) 0 0;
    padding: 0;
    display: grid;
    gap: 0 36px;
  }

  @media (min-width: 900px) {
    .way-list {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .way-list li {
    padding: 24px 0 30px;
    border-top: 1px solid var(--ink);
  }

  .way-num {
    display: block;
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(2.6rem, 4vw, 3.4rem);
    line-height: 1;
    color: var(--oxblood);
    margin-bottom: 16px;
  }

  .way-title {
    font-size: 1.6rem;
    line-height: 1.15;
    letter-spacing: -0.014em;
    margin-bottom: 10px;
  }

  .about-next {
    margin-top: 40px;
  }
</style>
