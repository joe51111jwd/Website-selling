---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import GlassHead from '../components/one/PageHead.astro';
import { glass } from '../theme';
---

<Base title="Page not found" noindex>
  {
    glass ? (
      <GlassHead kicker="404" title="This page didn’t make" dim="the final cut.">
        <Fragment slot="lead">It may have moved, or the link may be wrong. These are the pages people usually want.</Fragment>
        <p class="nf">
          <a href="/" class="o-btn">The one-sentence test</a>
          <a href="/services" class="o-link">Services and prices</a>
          <a href="/work" class="o-link">Notes</a>
        </p>
      </GlassHead>
    ) : (
      <PageHead kicker="404">
        <Fragment slot="title">This page <em>didn’t make the final cut.</em></Fragment>
        <Fragment slot="lead">It may have moved, or the link may be wrong. These are the pages people usually want.</Fragment>
        <div class="btn-row lost">
          <a href="/" class="btn">Home <span class="arrow" aria-hidden="true">→</span></a>
          <a href="/services" class="btn btn--ghost">Services and prices</a>
          <a href="/work" class="btn btn--ghost">Work</a>
        </div>
      </PageHead>
    )
  }
</Base>

<style>
  .lost {
    margin-top: 36px;
  }

  .nf {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 22px;
    margin: 8px 0 0;
  }
</style>
