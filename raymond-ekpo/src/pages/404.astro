---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import LPageHead from '../components/liquid/PageHead.astro';
import { glass } from '../theme';
---

<Base title="Page not found" noindex>
  {
    glass ? (
      <LPageHead eyebrow="404" title="This page" dim="didn’t make the final cut.">
        <Fragment slot="lead">It may have moved, or the link may be wrong. These are the pages people usually want.</Fragment>
        <div class="l-btns l-lost">
          <a href="/" class="l-btn l-btn--primary">Home</a>
          <a href="/services" class="l-btn">Services and prices</a>
          <a href="/work" class="l-btn">Work</a>
        </div>
      </LPageHead>
    ) : (
      <PageHead kicker="404">
        <Fragment slot="title">This page <em>didn’t make the final cut.</em></Fragment>
        <Fragment slot="lead">It may have moved, or the link may be wrong. These are the pages people usually want.</Fragment>
        <div class="btn-row lost">
          <a href="/" class="btn">Home <span class="arrow" aria-hidden="true">→</span></a>
          <a href="/services" class="btn btn--ghost">Services and prices</a>
          <a href="/work" class="btn btn--ghost">Work</a>
        </div>
      </PageHead>
    )
  }
</Base>

<style>
  .lost,
  .l-lost {
    margin-top: 36px;
  }
</style>
