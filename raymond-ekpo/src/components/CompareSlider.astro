---
import type { WorkEntry } from '../lib/content';

// One slide, original underneath and rewrite on top. Drag across it (or use the arrow keys) to compare.
interface Props {
  example: NonNullable<WorkEntry['data']['example']>;
  label?: string;
}

const { example, label = `Compare the original ${example.slide.toLowerCase()} slide with the rewrite` } = Astro.props;
---

<div class="cmp" data-compare style="--pos: 50%">
  <input class="cmp-range" type="range" min="0" max="100" value="50" aria-label={label} />
  <div class="cmp-frame">
    <div class="cs cs--before">
      <p class="cs-head">{example.before.headline}</p>
      <ul>
        {example.before.points.map((p) => <li>{p}</li>)}
      </ul>
    </div>
    <div class="cs cs--after">
      <p class="cs-label">{example.slide}</p>
      <p class="cs-head">{example.after.headline}</p>
      <ol>
        {example.after.points.map((p) => <li>{p}</li>)}
      </ol>
    </div>
    <span class="cmp-tag cmp-tag--before" aria-hidden="true">Before</span>
    <span class="cmp-tag cmp-tag--after" aria-hidden="true">After</span>
    <div class="cmp-handle" aria-hidden="true">
      <span class="cmp-knob"><span>‹</span><span>›</span></span>
    </div>
  </div>
  <p class="fig cmp-fig"><b>Drag</b> Illustrative. The company, numbers and events are invented to show the reasoning.</p>
</div>

<style>
  .cmp {
    position: relative;
  }

  .cmp-range {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  .cmp-frame {
    container-type: inline-size;
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border: 1px solid var(--rule);
    box-shadow: 0 30px 60px -40px rgb(27 26 23 / 0.55);
    cursor: ew-resize;
    touch-action: pan-y;
    user-select: none;
    -webkit-user-select: none;
  }

  @media (max-width: 640px) {
    .cmp-frame {
      aspect-ratio: 4 / 3.6;
    }
  }

  .cs {
    position: absolute;
    inset: 0;
    /* room at the top for the Before / After tags on small screens */
    padding: max(7cqi, 48px) 8cqi 7cqi;
  }

  .cs ul,
  .cs ol {
    margin: 0;
    padding: 0;
  }

  /* The deck as it usually arrives: centred, generic, bulleted */
  .cs--before {
    background: #fdfdfc;
    font-family: Arial, Helvetica, sans-serif;
    color: #555;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
  }

  .cs--before .cs-head {
    font-size: clamp(17px, 5.4cqi, 44px);
    font-weight: 700;
    color: #2d3a4a;
    line-height: 1.15;
    margin-bottom: 4.5cqi;
  }

  .cs--before ul {
    text-align: left;
    padding-left: 1.1em;
  }

  .cs--before li {
    font-size: clamp(12px, 2.7cqi, 21px);
    line-height: 1.45;
  }

  .cs--before li + li {
    margin-top: 1.2cqi;
  }

  /* The rewrite: the headline makes the claim, the points prove it */
  .cs--after {
    background: var(--sheet);
    color: var(--text);
    clip-path: inset(0 0 0 var(--pos));
  }

  .cs-label {
    font-size: clamp(9px, 1.7cqi, 13px);
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--oxblood);
    margin-bottom: 2.6cqi;
  }

  .cs--after .cs-head {
    font-family: var(--serif);
    font-size: clamp(18px, 5cqi, 42px);
    line-height: 1.08;
    letter-spacing: -0.022em;
    color: var(--ink);
    margin-bottom: 4cqi;
    max-width: 22em;
    text-wrap: balance;
  }

  .cs--after ol {
    list-style: none;
    counter-reset: pt;
  }

  .cs--after li {
    counter-increment: pt;
    display: grid;
    grid-template-columns: 2.4em 1fr;
    font-size: clamp(12px, 2.4cqi, 19px);
    line-height: 1.4;
    padding: 1.5cqi 0;
    border-top: 1px solid var(--rule);
  }

  .cs--after li::before {
    content: counter(pt, decimal-leading-zero);
    font-family: var(--serif);
    font-style: italic;
    color: var(--oxblood);
  }

  .cmp-tag {
    position: absolute;
    top: 14px;
    padding: 4px 10px 5px;
    font-family: var(--serif);
    font-style: italic;
    font-size: 0.95rem;
    line-height: 1;
    border-radius: 999px;
    pointer-events: none;
    white-space: nowrap;
  }

  /* The tags ride either side of the handle */
  .cmp-tag--before {
    right: calc(100% - var(--pos) + 14px);
    border: 1px solid #b9b9b9;
    color: #6b6b6b;
    background: #fff;
  }

  .cmp-tag--after {
    left: calc(var(--pos) + 14px);
    background: var(--oxblood);
    color: var(--paper);
  }

  .cmp-handle {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--pos);
    width: 2px;
    margin-left: -1px;
    background: var(--oxblood);
    pointer-events: none;
  }

  .cmp-knob {
    position: absolute;
    top: 50%;
    left: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    width: 52px;
    height: 52px;
    margin: -26px 0 0 -26px;
    border-radius: 50%;
    background: var(--oxblood);
    color: var(--paper);
    font-size: 1.2rem;
    line-height: 1;
    box-shadow: 0 8px 24px -6px rgb(27 26 23 / 0.45);
    transition: transform 0.2s ease;
  }

  .cmp-frame:hover .cmp-knob,
  :global(.dragging) .cmp-knob {
    transform: scale(1.08);
  }

  .cmp-range:focus-visible + .cmp-frame .cmp-knob {
    outline: 2px solid var(--ink);
    outline-offset: 3px;
  }

  .cmp-fig {
    margin-top: 14px;
  }
</style>
