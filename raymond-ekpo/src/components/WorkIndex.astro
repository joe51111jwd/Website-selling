---
import { pad, readingMinutes, type WorkEntry } from '../lib/content';

interface Props {
  entries: WorkEntry[];
  dark?: boolean;
}

const { entries, dark = false } = Astro.props;
---

<ol class:list={['index', { 'index--dark': dark }]} data-preview-list>
  {
    entries.map((e, i) => (
      <li>
        <a
          href={`/work/${e.id}`}
          class="row"
          data-preview={e.data.example?.after.headline ?? e.data.dek}
          data-preview-label={e.data.example ? `${e.data.example.slide} · the rewrite` : e.data.topic}
        >
          <span class="row-num figures">{pad(i + 1)}</span>
          <span class="row-main">
            <span class="row-title">{e.data.title}</span>
            <span class="row-dek">{e.data.dek}</span>
          </span>
          <span class="row-meta">
            <span class="caps">{e.data.topic}</span>
            <span class="meta">{readingMinutes(e.body)} min read</span>
          </span>
          <span class="row-arrow" aria-hidden="true">
            →
          </span>
        </a>
      </li>
    ))
  }
</ol>

<style>
  .index {
    list-style: none;
    margin: 0;
    padding: 0;
    border-bottom: 1px solid var(--ink);
  }

  .row {
    position: relative;
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: 6px 16px;
    padding: 26px 0;
    color: inherit;
    text-decoration: none;
  }

  li {
    border-top: 1px solid var(--rule);
  }

  li:first-child {
    border-top-color: var(--ink);
  }

  @media (min-width: 900px) {
    .row {
      grid-template-columns: 6rem 1fr 13rem 2rem;
      gap: 32px;
      padding: 32px 0;
      align-items: baseline;
    }
  }

  /* An oxblood wash that wipes in from the left on hover */
  .row::before {
    content: '';
    position: absolute;
    inset: 0 -12px;
    background: var(--paper-deep);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.45s cubic-bezier(0.2, 0.7, 0.2, 1);
    z-index: -1;
  }

  .row:hover::before {
    transform: scaleX(1);
  }

  li {
    position: relative;
    z-index: 0;
  }

  .row-num {
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(1.4rem, 2.6vw, 2.6rem);
    line-height: 1;
    color: var(--oxblood);
  }

  .row-main {
    display: flex;
    flex-direction: column;
    gap: 8px;
    transition: transform 0.45s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  .row:hover .row-main {
    transform: translateX(10px);
  }

  .row-title {
    font-family: var(--serif);
    font-size: clamp(1.5rem, 2.8vw, 2.3rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  .row-dek {
    color: var(--muted);
    font-size: 0.98rem;
    max-width: 44em;
  }

  .row-meta {
    grid-column: 2;
    display: flex;
    gap: 14px;
    align-items: baseline;
    color: var(--ink);
  }

  @media (min-width: 900px) {
    .row-meta {
      grid-column: auto;
      flex-direction: column;
      gap: 4px;
    }
  }

  .row-arrow {
    display: none;
    font-size: 1.4rem;
    color: var(--ink);
    transition: transform 0.3s ease;
  }

  @media (min-width: 900px) {
    .row-arrow {
      display: block;
    }
  }

  .row:hover .row-arrow {
    transform: translateX(6px);
    color: var(--oxblood);
  }

  .index--dark {
    border-bottom-color: rgb(244 239 230 / 0.5);
  }

  .index--dark li {
    border-top-color: rgb(244 239 230 / 0.16);
  }

  .index--dark li:first-child {
    border-top-color: rgb(244 239 230 / 0.5);
  }

  .index--dark .row::before {
    background: rgb(244 239 230 / 0.06);
  }

  .index--dark .row-num {
    color: #e2a99b;
  }

  .index--dark .row-title,
  .index--dark .row-meta,
  .index--dark .row-arrow {
    color: var(--paper);
  }

  .index--dark .row-dek,
  .index--dark .meta {
    color: rgb(244 239 230 / 0.6);
  }

  .index--dark .row:hover .row-arrow {
    color: #e2a99b;
  }
</style>
