---
// The light behind every page: three soft colours drifting slowly, for the glass to bend. On the
// home page, the words that survive the visitor's sentence are set huge and faint behind it all.
---

<div class="o-backdrop" aria-hidden="true">
  <span class="o-blob o-blob--a"></span>
  <span class="o-blob o-blob--b"></span>
  <span class="o-blob o-blob--c"></span>
  <span class="o-ghost" data-ghost></span>
</div>
