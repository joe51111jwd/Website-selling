---
// A slide as founders usually write it, and the rewrite, divided by a rod of glass you drag
// (compare.ts). The before is set the way decks usually arrive: centred, generic, bulleted.
import type { WorkEntry } from '../../lib/content';

interface Props {
  example: NonNullable<WorkEntry['data']['example']>;
}

const { example } = Astro.props;
---

<div class="rc" data-rodcompare data-nodrag style="--pos: 50%">
  <input class="rc-range" type="range" min="0" max="100" value="50" aria-label={`Compare the ${example.slide.toLowerCase()} slide as usually written with the rewrite`} />
  <div class="rc-frame">
    <div class="rc-slide rc-before">
      <p class="rc-head">{example.before.headline}</p>
      <ul>
        {example.before.points.map((p) => <li>{p}</li>)}
      </ul>
    </div>
    <div class="rc-slide rc-after">
      <p class="rc-label">{example.slide}</p>
      <p class="rc-head">{example.after.headline}</p>
      <ol>
        {example.after.points.map((p) => <li>{p}</li>)}
      </ol>
    </div>
    <span class="rc-tag rc-tag--before" aria-hidden="true">As usually written</span>
    <span class="rc-tag rc-tag--after" aria-hidden="true">Rewritten</span>
    <div class="rc-rod" aria-hidden="true"></div>
  </div>
</div>

<style>
  .rc {
    position: relative;
    width: 100%;
  }

  .rc-range {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  .rc-frame {
    container-type: inline-size;
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 22px;
    box-shadow:
      0 0 0 1px rgb(16 16 18 / 0.06),
      0 30px 60px -34px rgb(40 40 90 / 0.45);
    cursor: ew-resize;
    touch-action: pan-y;
    user-select: none;
    -webkit-user-select: none;
  }

  @media (max-width: 640px) {
    .rc-frame {
      aspect-ratio: 4 / 4.4;
    }
  }

  .rc-slide {
    position: absolute;
    inset: 0;
    padding: max(7cqi, 44px) 8cqi 7cqi;
  }

  .rc-slide ul,
  .rc-slide ol {
    margin: 0;
    padding: 0;
  }

  .rc-before {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    background: #fff;
    color: #555;
    font-family: Arial, Helvetica, sans-serif;
  }

  .rc-before .rc-head {
    margin: 0 0 4.5cqi;
    font-size: clamp(17px, 5.2cqi, 46px);
    font-weight: 700;
    line-height: 1.15;
    color: #2d3a4a;
  }

  .rc-before ul {
    text-align: left;
    padding-left: 1.1em;
  }

  .rc-before li {
    font-size: clamp(12px, 2.6cqi, 22px);
    line-height: 1.45;
  }

  .rc-before li + li {
    margin-top: 1.2cqi;
  }

  .rc-after {
    display: flex;
    flex-direction: column;
    justify-content: center;
    background: var(--accent);
    color: rgb(255 255 255 / 0.95);
    clip-path: inset(0 0 0 var(--pos));
  }

  .rc-label {
    margin: 0 0 2.4cqi;
    font: 600 clamp(9px, 1.5cqi, 13px) / 1 var(--text);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.92);
  }

  .rc-after .rc-head {
    margin: 0 0 4cqi;
    max-width: 18em;
    font: 500 clamp(19px, 4.8cqi, 44px) / 1.02 var(--disp);
    letter-spacing: -0.035em;
    color: #fff;
    text-wrap: balance;
  }

  .rc-after ol {
    list-style: none;
    counter-reset: pt;
  }

  .rc-after li {
    counter-increment: pt;
    display: grid;
    grid-template-columns: 2.6em 1fr;
    padding: 1.5cqi 0;
    border-top: 1px solid rgb(244 244 241 / 0.24);
    font: 400 clamp(12px, 2.1cqi, 19px) / 1.4 var(--text);
  }

  .rc-after li::before {
    content: counter(pt, decimal-leading-zero);
    font-family: var(--disp);
    font-weight: 500;
    color: #fff;
  }

  .rc-tag {
    position: absolute;
    top: 14px;
    padding: 6px 10px;
    border-radius: 999px;
    font: 500 0.78rem/1 var(--text);
    white-space: nowrap;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  .rc-tag--before {
    right: calc(100% - var(--pos) + 46px);
    background: #ededeb;
    color: #444;
  }

  .rc-tag--after {
    left: calc(var(--pos) + 46px);
    background: rgb(10 20 80 / 0.24);
    color: #fff;
  }

  /* the rod of glass that divides them */
  .rc-rod {
    position: absolute;
    top: -30px;
    bottom: -30px;
    left: var(--pos);
    width: clamp(46px, 7cqi, 84px);
    border-radius: 999px;
    transform: translateX(-50%);
    pointer-events: none;
    background: linear-gradient(
      90deg,
      rgb(255 255 255 / 0.12),
      rgb(255 255 255 / 0.5) 16%,
      rgb(255 255 255 / 0.06) 40%,
      rgb(255 255 255 / 0.02) 62%,
      rgb(255 255 255 / 0.36) 86%,
      rgb(255 255 255 / 0.1)
    );
    -webkit-backdrop-filter: blur(4px) saturate(1.5);
    backdrop-filter: blur(4px) saturate(1.5);
    box-shadow:
      inset 1px 0 0 rgb(255 255 255 / 0.9),
      inset -1px 0 0 rgb(255 255 255 / 0.6),
      0 0 30px rgb(0 0 0 / 0.2);
    transition: width 0.3s var(--ease);
  }

  .rc-rod:global(.is-lensed) {
    background: linear-gradient(
      90deg,
      rgb(255 255 255 / 0.14),
      rgb(255 255 255 / 0.26) 12%,
      transparent 36%,
      transparent 66%,
      rgb(255 255 255 / 0.2) 88%,
      rgb(255 255 255 / 0.1)
    );
    -webkit-backdrop-filter: var(--lens) saturate(1.4);
    backdrop-filter: var(--lens) saturate(1.4);
  }

  .rc-range:focus-visible + .rc-frame .rc-rod {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
</style>
