---
// Services in the glass build: the four engagements as glass cards with their prices and what's
// included, the fit check, the free mini-audit and the questions people ask before they enquire.
// If the visitor tried the one-sentence test, their sentence is shown back at the top.
import { render } from 'astro:content';
import type { Service } from '../../lib/content';
import PageHead from './PageHead.astro';
import FitCheck from './FitCheck.astro';

interface Props {
  services: Service[];
  faqs: { q: string; a: string }[];
}

const { services, faqs } = Astro.props;
const rendered = await Promise.all(services.map((s) => render(s)));
---

<PageHead kicker="Services" title="Four ways to work on it." dim="Each with a clear end.">
  <Fragment slot="lead">
    Fixed scopes and public prices. Each one starts from the investment case and ends with something you can take into
    your next investor meeting.
  </Fragment>
  <div class="sv-carry o-glass" data-carry hidden>
    <p class="o-fine">Your sentence</p>
    <p class="sv-carry-text" data-carry-text></p>
    <p class="o-fine"><span data-carry-score></span> · <a href="/" class="o-link">Keep working on it</a></p>
  </div>
</PageHead>

<section class="o-wrap" aria-label="The four engagements">
  <div class="sv-grid">
    {
      services.map((s, i) => {
        const { Content } = rendered[i];
        return (
          <article id={s.id} class="sv-card o-glass" aria-labelledby={`${s.id}-title`}>
            <div class="sv-top">
              <h2 id={`${s.id}-title`} class="o-h3">
                {s.data.title}
              </h2>
              <p class="o-fine">{s.data.for}</p>
            </div>
            <p class="sv-price">{s.data.price}</p>
            <p class="o-fine sv-note">{s.data.priceNote}</p>
            <p class="o-text">{s.data.youGet}</p>
            <details class="sv-more">
              <summary>What’s included</summary>
              <div class="sv-more-body">
                <p class="o-text">
                  <b>Best for:</b> {s.data.bestFor}
                </p>
                <div class="sv-prose o-text">
                  <Content />
                </div>
                <h3>What it covers</h3>
                <ul>
                  {s.data.covers.map((c) => (
                    <li>{c}</li>
                  ))}
                </ul>
                <h3>What you receive</h3>
                <ul>
                  {s.data.receive.map((c) => (
                    <li>{c}</li>
                  ))}
                </ul>
                <p class="o-text">
                  <b>What I need from you:</b> {s.data.needs}
                </p>
                {s.data.note && <p class="o-fine">{s.data.note}</p>}
              </div>
            </details>
            <a href={`/work-with-me?service=${s.id}`} class="o-btn sv-cta" data-cta={s.data.cta} data-cta-location="services page">
              {s.data.cta}
            </a>
          </article>
        );
      })
    }
  </div>
</section>

<section class="o-wrap sv-block" aria-label="Fit check">
  <FitCheck />
</section>

<section id="mini-audit" class="o-wrap sv-block" aria-labelledby="audit-title">
  <div class="sv-audit o-glass">
    <div>
      <p class="o-kicker">Free</p>
      <h2 id="audit-title" class="o-h2">The mini-audit.</h2>
    </div>
    <div class="sv-audit-body">
      <p class="o-lead">
        If you already have a deck, send it over and I’ll write back with a short note on the three changes I’d make first,
        and why. No call needed, and no obligation to work together afterwards.
      </p>
      <p class="o-fine">
        I only do a few each month, for founders raising pre-seed or seed in the next six months, so I may decline if it
        isn’t a fit or the month is full. I’ll tell you either way.
      </p>
      <p>
        <a href="/work-with-me?type=audit" class="o-btn" data-cta="Request a free deck audit" data-cta-location="services page">Request a mini-audit</a>
      </p>
    </div>
  </div>
</section>

<section id="faq" class="o-wrap sv-block" aria-labelledby="faq-title">
  <div class="sv-faq">
    <h2 id="faq-title" class="o-h2">Before you <span class="o-dim">enquire.</span></h2>
    <div class="sv-qs">
      {
        faqs.map((f, i) => (
          <details class="sv-q o-glass" open={i === 0}>
            <summary>
              {f.q}
              <span class="sv-plus" aria-hidden="true" />
            </summary>
            <p class="o-text">{f.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .sv-carry {
    display: grid;
    gap: 6px;
    max-width: 44rem;
    margin-top: 6px;
    padding: 16px 20px;
    border-radius: 22px;
  }

  .sv-carry[hidden] {
    display: none;
  }

  .sv-carry p {
    margin: 0;
  }

  .sv-carry-text {
    font: 500 1.15rem/1.35 var(--disp);
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  .sv-grid {
    display: grid;
    gap: 18px;
  }

  @media (min-width: 820px) {
    .sv-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .sv-card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: clamp(22px, 2.6vw, 32px);
    border-radius: 30px;
    scroll-margin-top: 24px;
  }

  .sv-top {
    display: grid;
    gap: 6px;
  }

  .sv-top p {
    margin: 0;
  }

  .sv-price {
    margin: 14px 0 0;
    font: 500 clamp(2rem, 3.2vw, 2.8rem) / 1 var(--disp);
    letter-spacing: -0.035em;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }

  .sv-note {
    margin-top: -2px;
  }

  .sv-more {
    margin-top: 6px;
    border-top: 1px solid var(--line);
  }

  .sv-more summary {
    display: flex;
    justify-content: space-between;
    padding: 14px 0 4px;
    font: 500 0.96rem/1.3 var(--text);
    cursor: pointer;
    list-style: none;
  }

  .sv-more summary::-webkit-details-marker {
    display: none;
  }

  .sv-more summary::after {
    content: '+';
    font-size: 1.2rem;
    line-height: 1;
    transition: transform 0.3s var(--ease);
  }

  .sv-more[open] summary::after {
    transform: rotate(45deg);
  }

  .sv-more-body {
    display: grid;
    gap: 12px;
    padding: 10px 0 4px;
    animation: o-rise 0.4s var(--ease) both;
  }

  .sv-more-body p,
  .sv-prose :global(p) {
    margin: 0;
  }

  .sv-more-body b {
    color: var(--ink);
    font-weight: 600;
  }

  .sv-more-body h3 {
    margin: 6px 0 0;
    font: 600 0.82rem/1.3 var(--text);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--mute);
  }

  .sv-more-body ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .sv-more-body li {
    position: relative;
    padding: 6px 0 6px 22px;
    color: var(--ink-2);
  }

  .sv-more-body li::before {
    content: '';
    position: absolute;
    left: 2px;
    top: 0.95em;
    width: 10px;
    height: 6px;
    border-left: 1.6px solid var(--accent);
    border-bottom: 1.6px solid var(--accent);
    transform: rotate(-45deg);
  }

  .sv-cta {
    align-self: flex-start;
    margin-top: auto;
  }

  .sv-more + .sv-cta {
    margin-top: 16px;
  }

  .sv-block {
    margin-top: clamp(64px, 9vw, 120px);
    scroll-margin-top: 24px;
  }

  .sv-audit {
    display: grid;
    gap: 22px;
    padding: clamp(26px, 4vw, 52px);
    border-radius: 34px;
  }

  @media (min-width: 900px) {
    .sv-audit {
      grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
      gap: 56px;
    }
  }

  .sv-audit-body {
    display: grid;
    gap: 16px;
    justify-items: start;
  }

  .sv-audit-body p {
    margin: 0;
  }

  .sv-faq {
    display: grid;
    gap: 28px;
  }

  @media (min-width: 900px) {
    .sv-faq {
      grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
      gap: 56px;
      align-items: start;
    }
  }

  .sv-qs {
    display: grid;
    gap: 10px;
  }

  .sv-q {
    border-radius: 22px;
  }

  .sv-q summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 18px;
    padding: 18px 22px;
    list-style: none;
    cursor: pointer;
    font: 500 1.08rem/1.3 var(--disp);
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  .sv-q summary::-webkit-details-marker {
    display: none;
  }

  .sv-plus {
    position: relative;
    flex: none;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: rgb(16 16 18 / 0.06);
  }

  .sv-plus::before,
  .sv-plus::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 11px;
    height: 1.6px;
    margin: -0.8px 0 0 -5.5px;
    background: var(--ink);
    transition: transform 0.35s var(--ease);
  }

  .sv-plus::after {
    transform: rotate(90deg);
  }

  .sv-q[open] .sv-plus::after {
    transform: rotate(0deg);
  }

  .sv-q p {
    margin: 0;
    padding: 0 22px 20px;
  }
</style>
