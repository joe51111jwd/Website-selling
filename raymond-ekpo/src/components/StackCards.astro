---
// Cards that pin and pile up as you scroll: each new one slides over the last, which sinks
// back a little. Pure CSS sticky; the script only adds the sinking.
interface Props {
  items: { title: string; body: string }[];
  label?: string;
}

const { items, label = 'Principle' } = Astro.props;
const roman = ['i', 'ii', 'iii', 'iv', 'v', 'vi'];
const tones = ['paper', 'desk', 'ink', 'ox'];
---

<ol class="stack" data-stack>
  {
    items.map((it, i) => (
      <li class:list={['stack-card', `stack-card--${tones[i % 4]}`]} style={`--i: ${i}`}>
        <div class="stack-inner">
          <span class="stack-num" aria-hidden="true">
            {roman[i]}.
          </span>
          <div class="stack-text">
            <p class="stack-count caps">
              {label} {String(i + 1).padStart(2, '0')} / {String(items.length).padStart(2, '0')}
            </p>
            <h3 class="display stack-title">{it.title}</h3>
            <p class="stack-body">{it.body}</p>
          </div>
        </div>
      </li>
    ))
  }
</ol>

<style>
  .stack {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .stack-card {
    --fg: var(--ink);
    --soft: var(--text);
    --accent: var(--oxblood);
    position: sticky;
    top: calc(96px + var(--i) * 26px);
    margin-bottom: clamp(48px, 14vh, 160px);
    transform-origin: 50% 0;
  }

  .stack-card:last-child {
    margin-bottom: 0;
  }

  .stack-inner {
    display: grid;
    gap: 20px;
    min-height: clamp(340px, 58vh, 540px);
    padding: clamp(28px, 4vw, 56px);
    background: var(--bg);
    color: var(--fg);
    box-shadow: 0 -18px 50px -30px rgb(27 26 23 / 0.45);
    transform: scale(var(--sink-scale, 1));
    filter: brightness(var(--sink-light, 1));
    transform-origin: 50% 0;
  }

  @media (min-width: 900px) {
    .stack-inner {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      align-items: end;
      gap: 48px;
    }
  }

  .stack-card--paper {
    --bg: var(--sheet);
  }

  .stack-card--desk {
    --bg: #e6dccb;
  }

  .stack-card--ink {
    --bg: var(--ink);
    --fg: var(--paper);
    --soft: rgb(244 239 230 / 0.75);
    --accent: #e2a99b;
  }

  .stack-card--ox {
    --bg: var(--oxblood);
    --fg: var(--paper);
    --soft: rgb(244 239 230 / 0.82);
    --accent: #f0cfc6;
  }

  .stack-card--paper .stack-inner {
    background-image: repeating-linear-gradient(transparent 0 31px, rgb(122 34 34 / 0.05) 31px 32px);
  }

  .stack-num {
    align-self: start;
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(6rem, 16vw, 15rem);
    line-height: 0.8;
    letter-spacing: -0.05em;
    color: var(--accent);
  }

  .stack-count {
    color: var(--accent);
    margin-bottom: 14px;
  }

  .stack-title {
    font-size: clamp(2.2rem, 4.6vw, 4.2rem);
    line-height: 0.98;
    letter-spacing: -0.032em;
    color: var(--fg);
  }

  .stack-body {
    margin-top: 18px;
    font-size: clamp(1.05rem, 1.4vw, 1.2rem);
    color: var(--soft);
    max-width: 34em;
  }
</style>
