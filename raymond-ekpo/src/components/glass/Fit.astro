---
// § 03 The fit check, as a panel of liquid controls and a glass term sheet.
import FitCheck from '../FitCheck.astro';
import { getServices } from '../../lib/content';

const services = await getServices();
---

<section class="g-fit" aria-labelledby="fit-title">
  <div class="wrap">
    <header class="g-head">
      <p class="kicker"><span class="num">§ 03</span> Fit check</p>
      <h2 id="fit-title" class="display g-h2">Twenty seconds. <em>Five answers. Your term sheet.</em></h2>
      <p class="g-lead">
        Tell me where the raise stands and the sheet drafts itself: which engagements fit, in what order, and what
        they cost. If I’m not the right person, it says so.
      </p>
    </header>
    <FitCheck services={services} />
  </div>
</section>

<style>
  .g-fit {
    padding-block: clamp(72px, 9vw, 130px);
  }
</style>
