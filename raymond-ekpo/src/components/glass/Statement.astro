---
// The short version, set large. Its words ink in as you read down the page (motion.ts).
const statement =
  'Investors don’t fund slides. They fund an argument they can repeat to their partners on *Monday morning.* My job is to find that argument in what you’ve built, make every claim in it defensible, and only then put it on slides.';
let inEm = false;
const words = statement.split(' ').map((raw) => {
  if (raw.startsWith('*')) inEm = true;
  const w = { text: raw.replace(/\*/g, ''), em: inEm };
  if (raw.endsWith('*') || raw.endsWith('*.')) inEm = false;
  return w;
});
---

<section class="g-statement wrap" aria-label="The short version">
  <p class="display g-statement-text" data-words>
    {
      words.map((w) => (
        <>
          <span class:list={['w', { 'w--em': w.em }]}>{w.text}</span>{' '}
        </>
      ))
    }
  </p>
</section>

<style>
  .g-statement {
    padding-block: clamp(96px, 14vw, 200px) clamp(72px, 10vw, 140px);
  }

  .g-statement-text {
    margin: 0;
    max-width: 21em;
    font-size: clamp(1.85rem, 3.7vw, 3.35rem);
    line-height: 1.12;
    letter-spacing: -0.022em;
    color: var(--ink);
  }

  .w {
    transition: color 0.5s ease;
  }

  :global(.js) .w {
    color: rgb(21 17 15 / 0.5);
  }

  :global(.js) .w.on {
    color: var(--ink);
  }

  .w--em {
    font-style: italic;
  }

  :global(.js) .w--em.on {
    color: var(--oxblood);
  }
</style>
