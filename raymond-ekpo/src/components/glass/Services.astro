---
// § 02 Services as four glass slabs standing in caustic light. One is open at a time (hover or
// click a spine; panels.ts); on phones they stack and open on tap.
import { getServices, pad } from '../../lib/content';

const services = await getServices();
---

<section class="g-services" id="services" data-world="light" aria-labelledby="services-title">
  <div class="wrap">
    <header class="g-head">
      <p class="kicker"><span class="num">§ 02</span> Services</p>
      <h2 id="services-title" class="display g-h2">Four ways to work together. <em>Every price is public.</em></h2>
      <p class="g-lead">
        Open one to see who it’s for, what it covers and what it costs, so you can decide whether this is worth a
        conversation without having one first.
      </p>
    </header>

    <div class="slabs" data-panels>
      {
        services.map((s, i) => (
          <article class:list={['panel', 'slab', { 'is-open': i === 0 }]} data-glass="pane">
            <button
              type="button"
              class="spine"
              aria-expanded={i === 0 ? 'true' : 'false'}
              aria-controls={`slab-${s.id}`}
            >
              <span class="spine-num figures">{pad(i + 1)}</span>
              <span class="spine-title" role="heading" aria-level="3">
                {s.data.title}
              </span>
              <span class="spine-price figures">{s.data.price}</span>
            </button>

            <div class="panel-body slab-body" id={`slab-${s.id}`}>
              <div class="slab-inner">
                <p class="caps slab-kicker">No. {pad(i + 1)}</p>
                <p class="display slab-title" aria-hidden="true">
                  {s.data.title}
                </p>
                <div class="slab-grid">
                  <dl class="slab-terms">
                    <div>
                      <dt class="caps">For</dt>
                      <dd>{s.data.for}</dd>
                    </div>
                    <div>
                      <dt class="caps">You get</dt>
                      <dd>{s.data.youGet}</dd>
                    </div>
                    <div>
                      <dt class="caps">Covers</dt>
                      <dd>
                        <ul>
                          {s.data.covers.slice(0, 3).map((c) => (
                            <li>{c}</li>
                          ))}
                        </ul>
                      </dd>
                    </div>
                  </dl>
                  <div class="slab-fee">
                    <span class="caps">Fee</span>
                    <span class="slab-price figures">{s.data.price}</span>
                    <span class="slab-note">{s.data.priceNote}</span>
                    <a
                      href={`/work-with-me?service=${s.id}`}
                      class="btn"
                      data-cta={s.data.cta}
                      data-cta-location="service slab"
                    >
                      {s.data.cta} <span class="arrow" aria-hidden="true">→</span>
                    </a>
                    <a href={`/services#${s.id}`} class="link slab-more">
                      Everything included <span class="arrow" aria-hidden="true">→</span>
                    </a>
                  </div>
                </div>
              </div>
            </div>
          </article>
        ))
      }
    </div>

    <div class="g-audit" data-glass="button-ox" data-reveal>
      <p class="g-audit-text">
        <span class="g-audit-tag">Complimentary</span>
        Already have a deck? Send it and I’ll write back with the <em>three changes I’d make first.</em>
      </p>
      <a href="/work-with-me?type=audit" class="g-audit-go" data-cta="Request a free deck audit" data-cta-location="services strip">
        Request a mini-audit <span class="arrow" aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>

<style>
  .g-services {
    padding-block: clamp(80px, 10vw, 150px);
  }

  .slabs {
    display: grid;
    gap: 14px;
    margin-top: clamp(36px, 5vw, 64px);
  }

  .slab {
    position: relative;
    border-radius: 30px;
    min-width: 0;
  }

  .spine {
    all: unset;
    box-sizing: border-box;
    cursor: pointer;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: baseline;
    gap: 14px;
    width: 100%;
    padding: 22px 26px;
    border-radius: 30px;
    color: var(--ink);
  }

  .spine:focus-visible {
    outline: 2px solid var(--oxblood);
    outline-offset: -4px;
  }

  .spine-num {
    font-family: var(--serif);
    font-style: italic;
    font-size: 1rem;
    color: var(--oxblood);
  }

  .spine-title {
    font-family: var(--serif);
    font-size: 1.45rem;
    letter-spacing: -0.012em;
    line-height: 1.15;
  }

  .spine-price {
    font-size: 0.95rem;
    color: var(--muted);
  }

  .slab-body {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.6s var(--ease-out);
  }

  .slab.is-open .slab-body {
    grid-template-rows: 1fr;
  }

  .slab-inner {
    min-height: 0;
    overflow: hidden;
    padding: 0 26px;
  }

  .slab.is-open .slab-inner {
    padding-bottom: 28px;
  }

  .slab-kicker {
    display: none;
  }

  .slab-title {
    display: none;
  }

  .slab-grid {
    display: grid;
    gap: 24px;
  }

  .slab-terms {
    margin: 0;
    display: grid;
    gap: 14px;
  }

  .slab-terms div {
    display: grid;
    gap: 4px;
  }

  .slab-terms dt {
    font-size: 0.66rem;
    color: var(--oxblood);
  }

  .slab-terms dd {
    margin: 0;
    color: var(--text);
    line-height: 1.5;
  }

  .slab-terms ul {
    margin: 0;
    padding-left: 1.1em;
  }

  .slab-terms li + li {
    margin-top: 4px;
  }

  .slab-fee {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
  }

  .slab-fee .caps {
    font-size: 0.66rem;
    color: var(--oxblood);
  }

  .slab-price {
    font-family: var(--serif);
    font-size: clamp(2.6rem, 4vw, 3.6rem);
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--ink);
  }

  .slab-note {
    color: var(--muted);
    font-size: 0.92rem;
    margin-bottom: 14px;
  }

  .slab-more {
    margin-top: 10px;
    font-size: 0.95rem;
  }

  /* wide screens: slabs stand side by side; the open one unfolds sideways */
  @media (min-width: 1000px) {
    .slabs {
      display: flex;
      gap: 16px;
      height: clamp(520px, 62vh, 600px);
    }

    .slab {
      flex: 0 0 108px;
      display: flex;
      transition: flex-basis 0.8s var(--ease-out), flex-grow 0.8s var(--ease-out);
      overflow: hidden;
    }

    .slab.is-open {
      flex: 1 1 auto;
    }

    .spine {
      flex: 0 0 108px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: space-between;
      height: 100%;
      padding: 28px 0;
    }

    .spine-title {
      writing-mode: vertical-rl;
      transform: rotate(180deg);
      font-size: 1.6rem;
      white-space: nowrap;
    }

    .spine-price {
      writing-mode: vertical-rl;
      transform: rotate(180deg);
    }

    .slab.is-open .spine {
      flex-basis: 84px;
    }

    .slab.is-open .spine-title,
    .slab.is-open .spine-price {
      opacity: 0;
    }

    .slab-body {
      display: block;
      flex: 1 1 auto;
      min-width: 0;
      opacity: 0;
      transition: opacity 0.35s ease;
    }

    .slab.is-open .slab-body {
      opacity: 1;
      transition: opacity 0.6s ease 0.25s;
    }

    .slab-inner {
      height: 100%;
      width: max(560px, 100%);
      padding: 34px 44px 36px 0;
      display: flex;
      flex-direction: column;
    }

    .slab-kicker {
      display: block;
      margin: 0 0 6px;
      font-size: 0.66rem;
      color: var(--oxblood);
    }

    .slab-title {
      display: block;
      margin: 0 0 auto;
      font-size: clamp(2.6rem, 4.2vw, 3.9rem);
      line-height: 1;
      letter-spacing: -0.03em;
      color: var(--ink);
    }

    .slab-grid {
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
      gap: 40px;
      align-items: end;
    }
  }

  .g-audit {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 14px 28px;
    margin-top: 18px;
    padding: 20px 26px;
    border-radius: 999px;
    color: #fff3ee;
  }

  :global(:root:not(.glass-gl)) .g-audit {
    background: linear-gradient(180deg, #8a251d, #66170f);
  }

  .g-audit-text {
    margin: 0;
    font-size: 1.04rem;
    line-height: 1.45;
  }

  .g-audit-text em {
    font-family: var(--serif);
    font-size: 1.12em;
  }

  .g-audit-tag {
    display: inline-block;
    margin-right: 10px;
    padding: 0.08em 0.7em 0.12em;
    border: 1px solid rgb(255 243 238 / 0.55);
    border-radius: 999px;
    font-family: var(--serif);
    font-style: italic;
    font-size: 0.92rem;
  }

  .g-audit-go {
    color: #fff;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }

  @media (max-width: 760px) {
    .g-audit {
      border-radius: 26px;
    }
  }
</style>
