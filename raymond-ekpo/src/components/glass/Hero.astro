---
// The Liquid Glass front page opener: the name cut from glass, with ink falling through it.
import { getServices } from '../../lib/content';
import { site } from '../../site.config';

const services = await getServices();
const short: Record<string, string> = {
  rewrite: 'Deck rewrite',
  creation: 'Deck creation',
  'qa-prep': 'Investor Q&A prep',
  'investor-research': 'Investor research',
};
---

<section
  class="g-hero"
  aria-labelledby="hero-title"
  data-ink="1"
  data-ink-x="0.3 0.94"
  data-ink-first="240"
  data-ink-y="-90"
  data-ink-every="5.2"
>
  <div class="wrap g-hero-in">
    <div class="g-meta caps fade-in" style="--fd: 0.1s">
      <span>{site.role}</span>
      <span class="g-meta-mid">For founders preparing to raise</span>
      <span>Pre-seed &amp; seed · US &amp; UK</span>
    </div>

    <div class="g-name-wrap">
      <span class="g-inkwell g-inkwell--name" data-ink-zone aria-hidden="true"></span>
      <p class="g-name display" aria-hidden="true">
        <span data-glass-text>Raymond</span>
        <span data-glass-text>Ekpo</span>
      </p>
    </div>

    <div class="g-hero-grid">
      <div class="g-hero-copy">
        <h1 id="hero-title" class="display g-hero-title fade-in" style="--fd: 0.45s">
          Investors fund what they can <em>explain</em> to someone else.
        </h1>
        <p class="g-hero-lead fade-in" style="--fd: 0.65s">
          I help pre-seed and seed founders turn what they’ve built into an investment case investors can follow,
          test and retell to their partners. The narrative comes first, then the deck.
        </p>
        <div class="btn-row fade-in" style="--fd: 0.8s">
          <a href="/work-with-me" class="btn" data-cta="Discuss your raise" data-cta-location="hero">
            Discuss your raise <span class="arrow" aria-hidden="true">→</span>
          </a>
          <a
            href="/work-with-me?type=audit"
            class="btn btn--ghost"
            data-cta="Request a free deck audit"
            data-cta-location="hero"
          >
            Free deck audit
          </a>
        </div>
      </div>
      <div class="g-inkwell g-inkwell--side" data-ink-zone aria-hidden="true">
        <p class="g-fig fade-in" style="--fd: 1.6s"><span>Fig. 1</span> Ink in water, finding its shape.</p>
      </div>
    </div>

    <nav class="g-dock fade-in" style="--fd: 0.9s" aria-label="Services and prices" data-glass="track" data-liquid>
      <span class="g-dock-thumb" data-liquid-thumb data-glass="thumb" aria-hidden="true"></span>
      {
        services.map((s) => (
          <a href={`/services#${s.id}`} data-liquid-item>
            <span class="g-dock-name">{short[s.id] ?? s.data.title}</span>
            <span class="g-dock-price figures">{s.data.price}</span>
          </a>
        ))
      }
      <a href="/work-with-me?type=audit" data-liquid-item data-cta="Request a free deck audit" data-cta-location="hero dock">
        <span class="g-dock-name">Deck mini-audit</span>
        <span class="g-dock-price">Complimentary</span>
      </a>
    </nav>
  </div>
</section>
