---
// § 01 Under the lens. A founder's traction slide, as it usually arrives. As you scroll, a glass
// lens sweeps it line by line, magnifying each line and leaving it rewritten. The slide and the
// lens are drawn by the renderer (src/scripts/glass/lens.ts, slide.ts); this is the page around
// them, and the plain-text version of every change.
const steps = [
  {
    title: 'Lead with the claim.',
    body: 'A headline should say what is true, not how it feels. The rest of the slide is there to prove it.',
    before: 'Strong early traction',
    after: 'Paying clinics up 3× in six months',
  },
  {
    title: 'A rate, not a total.',
    body: 'Totals only ever go up, so investors discount them. A rate from a stated base shows something is starting to work, and how fast.',
    before: '2,000+ users',
    after: '41 paying clinics, up from 13 in April',
  },
  {
    title: 'Proof that it sticks.',
    body: 'Press says people noticed. Retention says they stayed.',
    before: 'Featured in leading publications',
    after: '88% still active after 90 days',
  },
  {
    title: 'Name the source.',
    body: 'Where growth comes from tells an investor whether the product is doing the selling.',
    before: 'Leading clinics on board',
    after: '6 in 10 new clinics referred by a customer',
  },
];
---

<section class="lens" data-lens aria-labelledby="lens-title">
  <div class="lens-stage">
    <div class="wrap lens-grid">
      <div class="lens-copy">
        <p class="kicker"><span class="num">§ 01</span> Under the lens</p>
        <h2 id="lens-title" class="display lens-title">
          Most decks describe the company. <em>Few make the case for investing in it.</em>
        </h2>
        <ol class="lens-steps">
          {
            steps.map((s, i) => (
              <li class="lens-step" data-lens-step>
                <span class="lens-step-num figures">0{i + 1}</span>
                <div class="lens-step-text">
                  <h3 class="lens-step-title">{s.title}</h3>
                  <div class="lens-step-more">
                    <p class="lens-step-body">{s.body}</p>
                    <p class="lens-step-swap">
                      <span class="sr-only">Before: </span>
                      <s>{s.before}</s>
                      <span aria-hidden="true"> → </span>
                      <span class="sr-only">After: </span>
                      <span class="lens-after">{s.after}</span>
                    </p>
                  </div>
                </div>
              </li>
            ))
          }
        </ol>
        <a href="/work/traction-as-a-rate" class="lens-more link">Read the full analysis <span class="arrow" aria-hidden="true">→</span></a>
      </div>

      <figure class="lens-figure">
        <div
          class="lens-slide"
          data-lens-slide
          role="img"
          aria-label="A traction slide. Before: Strong early traction, 2,000+ users, featured in leading publications, leading clinics on board. After: paying clinics up three times in six months; 41 paying clinics, up from 13 in April; 88% still active after 90 days; 6 in 10 new clinics referred by a customer."
        >
          <canvas aria-hidden="true"></canvas>
        </div>
        <figcaption class="lens-cap">
          <span>Fig. 2</span> One traction slide, as it usually arrives and as it reads after a rewrite. The example is
          invented; the reasoning is the work.
        </figcaption>
      </figure>
    </div>
  </div>
</section>

<script>
  import { lensStory } from '../../scripts/glass/lens';
  lensStory();
</script>

<style>
  .lens {
    position: relative;
    height: 430vh;
  }

  .lens-stage {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    display: flex;
    align-items: center;
    padding-top: 84px;
    padding-bottom: 24px;
    overflow: hidden;
  }

  .lens-grid {
    display: grid;
    gap: 22px;
    align-items: center;
  }

  .lens-title {
    margin: 0 0 22px;
    font-size: clamp(1.7rem, 2.9vw, 2.65rem);
    line-height: 1.05;
    letter-spacing: -0.024em;
    color: var(--ink);
    max-width: 16em;
  }

  .lens-title em {
    color: var(--oxblood);
  }

  .lens-steps {
    list-style: none;
    margin: 0;
    padding: 0;
    counter-reset: step;
  }

  .lens-step {
    display: grid;
    grid-template-columns: 34px 1fr;
    gap: 4px 12px;
    padding: 12px 0 12px;
    border-top: 1px solid var(--rule);
    color: var(--muted);
    transition: color 0.4s ease;
  }

  .lens-step-num {
    font-family: var(--serif);
    font-style: italic;
    font-size: 0.95rem;
    padding-top: 0.15em;
    color: inherit;
  }

  .lens-step-title {
    margin: 0;
    font-family: var(--serif);
    font-weight: 400;
    font-size: 1.32rem;
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: inherit;
  }

  .lens-step-more {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    transition:
      grid-template-rows 0.55s var(--ease-out),
      opacity 0.4s ease;
  }

  .lens-step-more > * {
    min-height: 0;
  }

  .lens-step-more {
    overflow: hidden;
  }

  .lens-step-body {
    margin: 6px 0 0;
    font-size: 0.98rem;
    line-height: 1.5;
    color: var(--text);
  }

  .lens-step-swap {
    margin: 8px 0 2px;
    font-size: 0.9rem;
    line-height: 1.45;
    color: var(--muted);
  }

  .lens-step-swap s {
    text-decoration-color: var(--oxblood);
  }

  .lens-after {
    color: var(--ink);
    font-weight: 500;
  }

  .lens-step.is-active,
  .lens-step.is-done {
    color: var(--ink);
  }

  .lens-step.is-active .lens-step-num {
    color: var(--oxblood);
  }

  .lens-step.is-active .lens-step-more {
    grid-template-rows: 1fr;
    opacity: 1;
  }

  .lens-more {
    display: inline-flex;
    margin-top: 14px;
    opacity: 0;
    transform: translateY(6px);
    transition:
      opacity 0.5s ease,
      transform 0.5s var(--ease-out);
  }

  .lens.is-rewritten .lens-more {
    opacity: 1;
    transform: none;
  }

  .lens-figure {
    margin: 0;
  }

  .lens-slide {
    position: relative;
    aspect-ratio: 16 / 10;
    width: 100%;
    border-radius: 9px;
  }

  .lens-slide canvas {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: inherit;
    box-shadow:
      0 1px 2px rgb(40 20 10 / 0.08),
      0 24px 48px -24px rgb(40 20 10 / 0.35);
  }

  :global(.glass-gl) .lens-slide canvas {
    visibility: hidden;
  }

  .lens-cap {
    margin-top: 14px;
    font-family: var(--serif);
    font-style: italic;
    font-size: 0.92rem;
    line-height: 1.45;
    color: var(--muted);
    max-width: 40em;
  }

  .lens-cap span {
    font-style: normal;
    font-family: var(--sans);
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--oxblood);
    margin-right: 0.6em;
  }

  /* phones: the slide first, then only the step being worked on */
  @media (max-width: 999px) {
    .lens-copy {
      display: contents;
    }
    .lens-grid {
      grid-template-areas: 'kicker' 'title' 'figure' 'steps';
    }
    .lens-copy > .kicker {
      grid-area: kicker;
      margin: 0;
    }
    .lens-title {
      grid-area: title;
      margin: 0;
    }
    .lens-figure {
      grid-area: figure;
    }
    .lens-steps {
      grid-area: steps;
      min-height: 9.5em;
    }
    .lens-step:not(.is-active) {
      display: none;
    }
    .lens-step {
      border-top: 0;
      padding-top: 0;
    }
    .lens-more,
    .lens-cap {
      display: none;
    }
  }

  @media (min-width: 1000px) {
    .lens-grid {
      grid-template-columns: minmax(0, 4.6fr) minmax(0, 7.4fr);
      gap: 56px;
    }
  }

  @media (max-height: 760px) and (min-width: 1000px) {
    .lens-title {
      font-size: 2.1rem;
    }
    .lens-step {
      padding: 9px 0;
    }
  }
</style>
