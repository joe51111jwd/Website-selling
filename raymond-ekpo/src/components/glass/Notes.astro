---
// § 06 Notes and analyses, on a shelf of glass cards you drag sideways (shelf.ts).
import NotesShelf from '../NotesShelf.astro';
import { getWork } from '../../lib/content';

const notes = await getWork('analysis');
---

<section class="g-notes" aria-labelledby="notes-title">
  <div class="wrap">
    <header class="g-head">
      <p class="kicker"><span class="num">§ 06</span> Notes &amp; analyses</p>
      <h2 id="notes-title" class="display g-h2">How I think about <em>investor narratives.</em></h2>
      <p class="g-lead">
        Short analyses of the slides that decide most first meetings: what founders usually write, what investors
        hear, and what to write instead. Drag the shelf.
      </p>
    </header>
  </div>
  <NotesShelf entries={notes} />
</section>

<style>
  .g-notes {
    padding-block: clamp(72px, 9vw, 130px) clamp(40px, 6vw, 80px);
  }
</style>
