---
import type { WorkEntry } from '../lib/content';

interface Props {
  example: NonNullable<WorkEntry['data']['example']>;
  compact?: boolean;
}

const { example, compact = false } = Astro.props;
---

<figure class:list={['compare', { 'compare--compact': compact }]}>
  <div class="pair">
    <div class="side">
      <p class="side-label caps"><span class="dot dot--before"></span>Before</p>
      <div class="slide slide--before">
        <p class="s-label">{example.slide}</p>
        <p class="s-head">{example.before.headline}</p>
        <ul>
          {example.before.points.map((p) => <li>{p}</li>)}
        </ul>
      </div>
    </div>
    <div class="side">
      <p class="side-label caps"><span class="dot dot--after"></span>After</p>
      <div class="slide slide--after">
        <p class="s-label">{example.slide}</p>
        <p class="s-head">{example.after.headline}</p>
        <ol>
          {example.after.points.map((p) => <li>{p}</li>)}
        </ol>
      </div>
    </div>
  </div>
  <figcaption class="meta">
    Illustrative. The company, numbers and events are invented to show the reasoning.
  </figcaption>
</figure>

<style>
  .compare {
    margin: 0;
  }

  .pair {
    display: grid;
    gap: 20px;
  }

  @media (min-width: 760px) {
    .pair {
      grid-template-columns: 1fr 1fr;
      gap: 28px;
    }
  }

  /* cqi units inside a slide resolve against this wrapper, so the slide scales like a real one */
  .side {
    display: flex;
    flex-direction: column;
    container-type: inline-size;
  }

  .side-label {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--ink);
    margin-bottom: 10px;
  }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }

  .dot--before {
    border: 1px solid var(--muted);
  }

  .dot--after {
    background: var(--oxblood);
  }

  .slide {
    aspect-ratio: 16 / 9;
    flex: 1;
    padding: 6.5cqi 7cqi;
    border: 1px solid var(--rule);
    box-shadow: 0 16px 36px -28px rgb(27 26 23 / 0.4);
  }

  .slide ul,
  .slide ol {
    margin: 0;
    padding: 0;
  }

  /* The typical deck: centred title, generic sans, bullets */
  .slide--before {
    background: #fdfdfc;
    font-family: Arial, Helvetica, sans-serif;
    color: #555;
    text-align: center;
  }

  .slide--before .s-label {
    display: none;
  }

  .slide--before .s-head {
    font-size: clamp(16px, 5.6cqi, 38px);
    font-weight: 700;
    color: #2d3a4a;
    line-height: 1.15;
    margin-bottom: 5cqi;
  }

  .slide--before ul {
    display: inline-block;
    text-align: left;
    padding-left: 1.1em;
  }

  .slide--before li {
    font-size: clamp(12px, 3.1cqi, 20px);
    line-height: 1.45;
  }

  .slide--before li + li {
    margin-top: 1.2cqi;
  }

  /* The rewrite: the headline makes the claim, the points prove it */
  .slide--after {
    background: var(--sheet);
    color: var(--text);
  }

  .slide--after .s-label {
    font-size: clamp(9px, 1.8cqi, 12px);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--oxblood);
    margin-bottom: 2.4cqi;
  }

  .slide--after .s-head {
    font-family: var(--serif);
    font-size: clamp(16px, 4.9cqi, 34px);
    line-height: 1.12;
    letter-spacing: -0.02em;
    color: var(--ink);
    margin-bottom: 4cqi;
    text-wrap: balance;
  }

  .slide--after ol {
    list-style: none;
    counter-reset: pt;
  }

  .slide--after li {
    counter-increment: pt;
    display: grid;
    grid-template-columns: 2.2em 1fr;
    font-size: clamp(12px, 2.7cqi, 18px);
    line-height: 1.4;
    padding: 1.6cqi 0;
    border-top: 1px solid var(--rule);
  }

  .slide--after li::before {
    content: counter(pt, decimal-leading-zero);
    font-family: var(--serif);
    font-style: italic;
    color: var(--oxblood);
  }

  figcaption {
    margin-top: 16px;
  }

  .compare--compact figcaption {
    margin-top: 12px;
  }
</style>
