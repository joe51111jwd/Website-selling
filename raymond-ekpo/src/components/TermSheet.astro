---
import type { Service } from '../lib/content';
import { pad } from '../lib/content';

interface Props {
  service: Service;
  n: number;
}

const { service, n } = Astro.props;
const { title, price, priceNote, youGet } = service.data;
---

<article class="sheet">
  <header class="sheet-top">
    <span class="caps">Term sheet</span>
    <span class="sheet-no figures">No. {pad(n)}</span>
  </header>
  <h3 class="display sheet-title">{title}</h3>
  <dl class="sheet-terms">
    <div>
      <dt class="caps">For</dt>
      <dd>{service.data.for}</dd>
    </div>
    <div>
      <dt class="caps">You get</dt>
      <dd>{youGet}</dd>
    </div>
    <div class="sheet-fee">
      <dt class="caps">Fee</dt>
      <dd>
        <span class="price figures">{price}</span>
        <span class="price-note">{priceNote}</span>
      </dd>
    </div>
  </dl>
  <footer class="sheet-foot">
    <a href={`/services#${service.id}`} class="link">What’s included <span class="arrow" aria-hidden="true">→</span></a>
  </footer>
</article>

<style>
  .sheet {
    display: flex;
    flex-direction: column;
    background: var(--sheet);
    border: 1px solid var(--rule);
    padding: clamp(22px, 2.6vw, 34px);
    box-shadow:
      0 1px 0 rgb(27 26 23 / 0.04),
      0 18px 40px -28px rgb(27 26 23 / 0.35);
    transition:
      border-color 0.2s ease,
      transform 0.2s ease;
  }

  .sheet:hover {
    border-color: var(--ink);
  }

  .sheet-top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-bottom: 10px;
    border-bottom: 3px double var(--ink);
    color: var(--ink);
  }

  .sheet-no {
    font-family: var(--serif);
    font-style: italic;
    color: var(--oxblood);
  }

  .sheet-title {
    font-size: clamp(1.7rem, 2.4vw, 2.15rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
    margin: 22px 0 18px;
  }

  .sheet-terms {
    margin: 0;
    flex: 1;
  }

  .sheet-terms > div {
    display: grid;
    grid-template-columns: 5.5rem 1fr;
    gap: 16px;
    padding: 13px 0;
    border-top: 1px solid var(--rule);
  }

  .sheet-terms dt {
    color: var(--muted);
    padding-top: 0.2em;
  }

  .sheet-terms dd {
    margin: 0;
    color: var(--text);
    font-size: 0.98rem;
    line-height: 1.5;
  }

  .sheet-fee {
    border-bottom: 1px solid var(--rule);
    align-items: baseline;
  }

  .sheet-fee dd {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 14px;
  }

  .price {
    font-family: var(--serif);
    font-size: 1.85rem;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  .price-note {
    font-size: 0.85rem;
    color: var(--muted);
  }

  .sheet-foot {
    padding-top: 20px;
  }
</style>
