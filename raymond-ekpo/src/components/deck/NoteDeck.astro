---
// A note as a short deck: the title, the slide it's about with the glass divider to drag, then
// the argument one section to a slide (split at each heading), and an ask at the end.
import { render } from 'astro:content';
import type { WorkEntry } from '../../lib/content';
import { readingMinutes } from '../../lib/content';
import Deck from './Deck.astro';
import Slide from './Slide.astro';
import RodCompare from './RodCompare.astro';

interface Props {
  entry: WorkEntry;
  next: WorkEntry;
}

const { entry, next } = Astro.props;
const d = entry.data;
const isCase = d.kind === 'case-study';
const date = d.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });

// the note's own HTML, cut at each h2 into an opening and one section per heading
const html = entry.rendered?.html ?? '';
const { Content } = await render(entry);
const chunks = html ? html.split(/(?=<h2[\s>])/) : [];
const sections = chunks
  .map((c) => {
    const m = c.match(/^<h2[^>]*>([\s\S]*?)<\/h2>/);
    return m ? { heading: m[1].replace(/<[^>]+>/g, ''), body: c.slice(m[0].length) } : { heading: '', body: c };
  })
  .filter((s) => s.body.trim() || s.heading);

const facts = isCase
  ? ([
      ['Client', d.client],
      ['Stage', d.stage],
      ['Sector', d.sector],
      ['Outcome', d.outcome],
    ].filter(([, v]) => v) as [string, string][])
  : [];

const N = 1 + (d.example ? 1 : 0) + (sections.length || 1) + 1;
let n = 0;
const deckName = `Note · ${d.topic}`;
---

<Deck name="note" label={d.title}>
  <Slide id="note" title={d.title} section={`Appendix B · ${d.topic}`} n={++n} of={N} deck={deckName}>
    <div class="n1">
      <p class="d-kicker" data-b><a href="/work" class="n1-crumb">Notes</a> / {d.topic}</p>
      <h1 class="d-h1 n1-title" data-b>{d.title}</h1>
      <p class="d-lead" data-b>{d.dek}</p>
      <p class="d-fine n1-meta" data-b>
        <time datetime={d.date.toISOString()}>{date}</time> · {readingMinutes(entry.body)} min read
        {d.illustrative && <span class="n1-tag">Illustrative example</span>}
      </p>
      {
        facts.length > 0 && (
          <dl class="n1-facts" data-b>
            {facts.map(([k, v]) => (
              <div>
                <dt>{k}</dt>
                <dd>{v}</dd>
              </div>
            ))}
          </dl>
        )
      }
    </div>
  </Slide>

  {
    d.example && (
      <Slide id="the-slide" title={`The ${d.example.slide.toLowerCase()} slide`} section="Before & after" n={++n} of={N} deck={deckName}>
        <div class="n2">
          <div class="n2-copy">
            <h2 class="d-h2" data-b>
              The {d.example.slide.toLowerCase()} slide. <span class="d-dim">Drag the glass.</span>
            </h2>
            {d.illustrative && (
              <p class="d-fine" data-b>
                Illustrative. The company, numbers and events are invented to show the reasoning.
              </p>
            )}
          </div>
          <div data-b>
            <RodCompare example={d.example} />
          </div>
        </div>
      </Slide>
    )
  }

  {
    sections.length > 0 ? (
      sections.map((s, i) => (
        <Slide id={`part-${i + 1}`} title={s.heading || 'The argument'} section={s.heading || d.topic} n={++n} of={N} deck={deckName}>
          <div class:list={['n3', { 'n3--open': !s.heading }]}>
            {s.heading && (
              <h2 class="d-h2 n3-title" data-b>
                {s.heading}
              </h2>
            )}
            <div class="n3-prose" data-b set:html={s.body} />
          </div>
        </Slide>
      ))
    ) : (
      <Slide id="part-1" title="The argument" section={d.topic} n={++n} of={N} deck={deckName}>
        <div class="n3">
          <div class="n3-prose" data-b>
            <Content />
          </div>
        </div>
      </Slide>
    )
  }

  <Slide id="next" title="Does your deck do this?" section="Next" tone="ink" n={++n} of={N} deck={deckName}>
    <div class="n4">
      <h2 class="d-h1 n4-title" data-b>Does your deck do this? <span class="d-acc">Send it over for a complimentary mini-audit.</span></h2>
      <p class="d-lead" data-b>I’ll write back with the three changes I’d make first.</p>
      <div class="d-btns" data-b>
        <a href="/work-with-me?type=audit" class="d-btn" data-cta="Request a free deck audit" data-cta-location={`note: ${entry.id}`}>
          Request a mini-audit
        </a>
        {
          next.id !== entry.id && (
            <a href={`/work/${next.id}`} class="d-link">
              Next note: {next.data.title}
            </a>
          )
        }
      </div>
    </div>
  </Slide>
</Deck>

<style>
  .n1 {
    display: grid;
    gap: clamp(14px, 2.8vh, 30px);
  }

  .n1-crumb {
    color: inherit;
  }

  .n1-title {
    max-width: 13em;
  }

  .n1-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 12px;
  }

  .n1-tag {
    padding: 4px 8px;
    border-radius: 3px;
    background: rgb(31 47 214 / 0.1);
    color: var(--klein);
    font-weight: 500;
  }

  .n1-facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    margin: 0;
    border-top: 1px solid var(--rule-c);
  }

  .n1-facts div {
    padding: 12px 0;
  }

  .n1-facts dt {
    font: 500 var(--t-small) / 1.3 var(--text);
    color: var(--dim);
  }

  .n1-facts dd {
    margin: 4px 0 0;
  }

  .n2 {
    display: grid;
    gap: 26px;
    align-items: center;
  }

  @media (min-width: 1000px) {
    .n2 {
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
      gap: clamp(36px, 5vw, 80px);
    }
  }

  .n2-copy {
    display: grid;
    gap: 16px;
  }

  .n3 {
    display: grid;
    gap: clamp(18px, 3.6vh, 40px);
  }

  @media (min-width: 1000px) {
    .n3 {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: clamp(40px, 6vw, 100px);
      align-items: start;
    }
    .n3--open {
      grid-template-columns: minmax(0, 9fr) minmax(0, 3fr);
    }
  }

  .n3-title {
    max-width: 10em;
  }

  .n3-prose {
    max-width: 38em;
    font: 400 var(--t-lead) / 1.5 var(--text);
    color: var(--fg-2);
  }

  .n3--open .n3-prose {
    font-size: clamp(1.15rem, min(1.9vw, 3.1vh), 2rem);
    line-height: 1.4;
    color: var(--fg);
  }

  .n3-prose :global(p) {
    margin: 0;
  }

  .n3-prose :global(p + p),
  .n3-prose :global(* + ul),
  .n3-prose :global(* + ol) {
    margin-top: 0.85em;
  }

  .n3-prose :global(em) {
    color: var(--fg);
  }

  .n3-prose :global(strong) {
    color: var(--fg);
    font-weight: 600;
  }

  .n3-prose :global(a) {
    color: var(--fg);
    text-decoration-color: var(--acc);
    text-decoration-thickness: 1.5px;
    text-underline-offset: 0.2em;
  }

  .n3-prose :global(ul),
  .n3-prose :global(ol) {
    padding-left: 1.2em;
  }

  .n4 {
    display: grid;
    gap: clamp(18px, 3.6vh, 36px);
  }

  .n4-title {
    max-width: 14em;
  }
</style>
