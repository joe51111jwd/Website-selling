---
// A deck: slides that fill the screen, one at a time. deck.ts moves between them; without
// scripts they simply stack down the page.
interface Props {
  name: string;
  label: string;
}

const { name, label } = Astro.props;
---

<div class="d-deck" data-deck={name} role="region" aria-roledescription="slide deck" aria-label={label}>
  <slot />
</div>
