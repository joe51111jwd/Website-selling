---
// The presenter's controls, in glass over the slides: a bar with previous, the slide number
// (which opens the contents), next, the speaker notes and the way to get in touch; a progress
// line; the glass rod that wipes between slides; the contents, with every slide of this deck and
// the other decks; and the notes panel. On pages that are documents rather than decks (the
// enquiry form, privacy) the bar offers the way back to the deck instead.
import { site } from '../../site.config';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const decks = [
  { href: '/', label: 'The deck', match: (p: string) => p === '/' },
  { href: '/services', label: 'A · Engagements', match: (p: string) => p.startsWith('/services') },
  { href: '/work', label: 'B · Notes', match: (p: string) => p.startsWith('/work') && !p.startsWith('/work-with-me') },
  { href: '/about', label: 'C · About', match: (p: string) => p.startsWith('/about') },
  { href: '/work-with-me', label: 'The ask', match: (p: string) => p.startsWith('/work-with-me') },
];
const year = new Date().getFullYear();
---

<div class="d-progress" data-progress aria-hidden="true"><span></span></div>
<div class="d-rod" data-rod data-lens-rod hidden aria-hidden="true"></div>

<nav class="pb d-glass" data-pb data-seg="hover" data-lens-glass="3" aria-label="Presenter controls">
  <span class="pb-thumb" data-seg-thumb aria-hidden="true"></span>
  <a href="/" class="pb-btn" data-doc-only data-seg-item>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7"></path></svg>
    <span>The deck</span>
  </a>
  <button type="button" class="pb-btn" data-prev data-deck-only data-seg-item aria-label="Previous slide">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7"></path></svg>
  </button>
  <button type="button" class="pb-count" data-contents-open data-seg-item aria-haspopup="dialog" aria-expanded="false">
    <span data-deck-only class="pb-nums"
      ><span class="sr-only">Contents. Slide </span><span data-no>01</span> <span class="pb-of" data-of></span></span
    >
    <span class="pb-title" data-title>Contents</span>
  </button>
  <button type="button" class="pb-btn" data-next data-deck-only data-seg-item aria-label="Next slide">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7"></path></svg>
  </button>
  <span class="pb-sep" data-deck-only aria-hidden="true"></span>
  <button type="button" class="pb-btn" data-notes-toggle data-deck-only data-seg-item aria-pressed="false" aria-label="Speaker notes">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 5h14v10H9l-4 4z M9 9h6 M9 12h4"></path></svg>
    <span class="pb-label" aria-hidden="true">Notes</span>
  </button>
  <a href="/work-with-me" class="pb-cta" data-not-ask data-cta="Discuss your raise" data-cta-location="presenter bar">Discuss your raise</a>
</nav>

<div class="d-contents" data-contents hidden role="dialog" aria-modal="true" aria-labelledby="dc-title">
  <div class="dc-head">
    <h2 id="dc-title" class="dc-title">Contents</h2>
    <ul class="dc-decks d-glass" data-tone="ink">
      {
        decks.map((d) => (
          <li>
            <a href={d.href} aria-current={d.match(path) ? 'page' : undefined}>
              {d.label}
            </a>
          </li>
        ))
      }
    </ul>
    <button type="button" class="dc-close d-glass" data-tone="ink" data-contents-close aria-label="Close contents">✕</button>
  </div>
  <div class="dc-scroll">
    <ol class="dc-grid" data-contents-grid></ol>
    <p class="dc-foot">
      © {year} {site.name} · <a href="/privacy">Privacy</a> · <a href={site.x.url} rel="me noopener" target="_blank" data-contact="x">X</a> ·{' '}
      <a href={site.linkedin} rel="me noopener" target="_blank" data-contact="linkedin">LinkedIn</a> · Also runs{' '}
      <a href={site.firm.url} rel="noopener" target="_blank">{site.firm.name}</a>
    </p>
  </div>
</div>

<aside class="d-notesbox d-glass" data-notesbox hidden aria-label="Speaker notes">
  <p class="dn-head"><span>Speaker notes</span><span data-notes-slide></span></p>
  <div class="dn-body" data-notes-body aria-live="polite"></div>
</aside>

<p class="sr-only" data-live aria-live="polite"></p>

<style>
  .dc-scroll {
    min-height: 0;
    overflow-y: auto;
  }

  .dc-scroll .dc-grid {
    overflow: visible;
    padding-bottom: 40px;
  }

  .dc-foot {
    margin: 0;
    padding: 0 var(--pad-x) 120px;
    font: 400 0.88rem/1.6 var(--text);
    color: rgb(244 244 241 / 0.72);
  }

  .dc-foot a {
    color: var(--chalk);
  }

  .pb-nums {
    display: inline-flex;
    gap: 4px;
  }

  :global(:root:not(.js)) .pb {
    display: none;
  }

  .pb:not(:global(.is-doc)) [data-doc-only],
  .pb:global(.is-doc) [data-deck-only] {
    display: none;
  }

  .pb:global(.is-ask) [data-not-ask] {
    display: none;
  }

  .pb:global(.is-doc) .pb-title {
    padding-left: 0;
    border-left: 0;
  }
</style>
