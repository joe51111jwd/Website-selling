---
// Appendix C: who you'd be working with. Where the work comes from, the short version, what he
// believes about fundraising narratives and how he works.
import { site } from '../../site.config';
import Deck from './Deck.astro';
import Slide from './Slide.astro';

interface Props {
  beliefs: { title: string; body: string }[];
  ways: { title: string; body: string }[];
}

const { beliefs, ways } = Astro.props;
const N = 5;
const deckName = 'Appendix C · About';
---

<Deck name="about" label="Appendix C: about Raymond Ekpo">
  <Slide id="about" title="About" section="Appendix C" n={1} of={N} deck={deckName}>
    <div class="c1">
      <div class="c1-copy">
        <p class="d-kicker" data-b>Appendix C</p>
        <h1 class="d-h1 c1-title" data-b>I work on the part of a raise <span class="d-dim">that happens before the slides.</span></h1>
        <p class="d-lead" data-b>
          I’m {site.name}. I help pre-seed and seed founders in the US and UK explain why their company is worth investing
          in: the thesis, the storyline, and the claims that hold it up.
        </p>
      </div>
      <div class="c1-id" data-b>
        {
          site.portrait ? (
            <img src={site.portrait} alt={site.name} class="c1-photo" width="640" height="800" />
          ) : (
            <span class="c1-mono" aria-hidden="true">
              RE
            </span>
          )
        }
        <dl class="c1-facts">
          <div>
            <dt>Works with</dt>
            <dd>Pre-seed and seed founders</dd>
          </div>
          <div>
            <dt>Raising from</dt>
            <dd>US and UK investors</dd>
          </div>
          <div>
            <dt>Also</dt>
            <dd>
              Founder, <a href={site.firm.url} rel="noopener" target="_blank">{site.firm.name}</a>
            </dd>
          </div>
          <div>
            <dt>Elsewhere</dt>
            <dd>
              <a href={site.x.url} rel="me noopener" target="_blank" data-contact="x">X {site.x.handle}</a> ·{' '}
              <a href={site.linkedin} rel="me noopener" target="_blank" data-contact="linkedin">LinkedIn</a>
            </dd>
          </div>
        </dl>
      </div>
    </div>
  </Slide>

  <Slide id="where" title="Where this comes from" section="C2 · Where this comes from" n={2} of={N} deck={deckName}>
    <div class="c2">
      <h2 class="d-h2 c2-title" data-b>Where this <span class="d-dim">comes from.</span></h2>
      <div class="c2-prose">
        <p class="d-lead" data-b>
          I spent several years studying how markets work, mostly by watching capable companies stall for reasons nobody
          inside them could name. That work became <a href={site.firm.url} rel="noopener" target="_blank">{site.firm.name}</a>,
          the growth strategy firm I run. The job there is to establish what’s actually in the way and write it down in a
          form people can argue with.
        </p>
        <p class="d-lead" data-b>
          The same problem turns up at the very start of a company, in a different form. A founder knows the product, the
          customers and the market better than anyone, and still struggles to say why it’s an investment. That’s a
          different question from why it’s a good product.
        </p>
      </div>
    </div>
  </Slide>

  <Slide id="short-version" title="The short version" section="C3 · The short version" tone="klein" n={3} of={N} deck={deckName}>
    <blockquote class="c3" data-b>
      <p class="d-display">A pitch deck is a positioning problem <span class="d-dim">with a different buyer.</span></p>
    </blockquote>
  </Slide>

  <Slide id="beliefs" title="Beliefs" section="C4 · Beliefs" tone="ink" n={4} of={N} deck={deckName}>
    <div class="c4">
      <h2 class="d-h2" data-b>How I think about <span class="d-dim">fundraising narratives.</span></h2>
      <ol class="c4-cols">
        {
          beliefs.map((b, i) => (
            <li data-b>
              <span class="d-num">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="d-h3">{b.title}</h3>
              <p class="d-text">{b.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </Slide>

  <Slide id="practice" title="How I work" section="C5 · Practice" n={5} of={N} deck={deckName}>
    <div class="c5">
      <h2 class="d-h2" data-b>How I <span class="d-dim">work.</span></h2>
      <ol class="c5-rows">
        {
          ways.map((w) => (
            <li data-b>
              <h3 class="d-h3">{w.title}</h3>
              <p class="d-text">{w.body}</p>
            </li>
          ))
        }
      </ol>
      <div class="d-btns" data-b>
        <a href="/services" class="d-btn">See the engagements and prices</a>
        <a href="/#ask" class="d-link">Back to the deck’s ask</a>
      </div>
    </div>
  </Slide>
</Deck>

<style>
  .c1 {
    display: grid;
    gap: 32px;
  }

  @media (min-width: 1000px) {
    .c1 {
      grid-template-columns: minmax(0, 8fr) minmax(260px, 4fr);
      gap: clamp(40px, 6vw, 110px);
      align-items: end;
    }
  }

  .c1-copy {
    display: grid;
    gap: clamp(16px, 3vh, 32px);
  }

  .c1-title {
    max-width: 12em;
  }

  .c1-id {
    display: grid;
    justify-items: start;
  }

  .c1-mono {
    display: grid;
    place-items: center;
    width: clamp(90px, 13vh, 140px);
    aspect-ratio: 1;
    margin-bottom: 18px;
    background: var(--klein);
    color: var(--chalk);
    font: 800 clamp(2rem, 5vh, 3.4rem) / 1 var(--disp);
    letter-spacing: -0.04em;
  }

  .c1-photo {
    width: 100%;
    height: auto;
    margin-bottom: 18px;
  }

  .c1-facts {
    width: 100%;
    margin: 0;
  }

  .c1-facts div {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 10px 0;
    border-top: 1px solid var(--rule-c);
    font: 400 var(--t-small) / 1.4 var(--text);
  }

  .c1-facts dt {
    color: var(--dim);
  }

  .c1-facts dd {
    margin: 0;
    text-align: right;
  }

  .c1-facts a {
    color: inherit;
  }

  .c2 {
    display: grid;
    gap: 28px;
  }

  @media (min-width: 1000px) {
    .c2 {
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
      gap: clamp(40px, 6vw, 110px);
      align-items: start;
    }
  }

  .c2-prose {
    display: grid;
    gap: 1em;
  }

  .c2-prose a {
    color: var(--fg);
    text-decoration-color: var(--acc);
    text-underline-offset: 0.2em;
  }

  .c3 {
    margin: 0;
  }

  .c3 .d-display {
    max-width: 11em;
  }

  .c4 {
    display: grid;
    gap: clamp(26px, 6vh, 64px);
  }

  .c4-cols,
  .c5-rows {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .c4-cols {
    display: grid;
    gap: 24px 40px;
  }

  @media (min-width: 900px) {
    .c4-cols {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .c4-cols li {
    display: grid;
    gap: 12px;
    align-content: start;
    padding-top: 16px;
    border-top: 1px solid var(--rule-c);
  }

  .c5 {
    display: grid;
    gap: clamp(22px, 4.4vh, 48px);
  }

  .c5-rows li {
    display: grid;
    gap: 8px 48px;
    padding: clamp(12px, 2.4vh, 22px) 0;
    border-top: 1px solid var(--rule-c);
  }

  @media (min-width: 900px) {
    .c5-rows li {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      align-items: baseline;
    }
  }

  .c5-rows .d-text {
    max-width: 36em;
  }
</style>
