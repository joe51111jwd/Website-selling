---
// One slide: the furniture a real deck carries (name, section, footer, page number), the body,
// and speaker notes on why the slide is built the way it is. The notes stay hidden until the
// presenter bar's Notes button shows them.
import { site } from '../../site.config';

interface Props {
  id: string;
  title: string;
  n: number;
  of: number;
  section?: string;
  tone?: 'chalk' | 'ink' | 'klein';
  deck?: string;
  class?: string;
}

const { id, title, n, of, section = title, tone = 'chalk', deck = 'Investor narrative · Pre-seed & seed · US & UK', class: cls } = Astro.props;
const pad = (v: number) => String(v).padStart(2, '0');
---

<section
  id={id}
  class:list={['d-slide', `d-slide--${tone}`, cls]}
  data-title={title}
  data-tone={tone}
  aria-roledescription="slide"
  aria-label={`${n} of ${of}: ${title}`}
  tabindex="-1"
>
  <header class="d-furn d-furn--top">
    <a href="/" class="d-mark">{site.name}</a>
    <span class="d-sec">{section}</span>
  </header>
  <div class="d-body">
    <slot />
  </div>
  <footer class="d-furn d-furn--bot">
    <span>{deck}</span>
    <span class="d-no">{pad(n)} / {pad(of)}</span>
  </footer>
  {
    Astro.slots.has('notes') && (
      <div class="d-notes">
        <slot name="notes" />
      </div>
    )
  }
</section>
