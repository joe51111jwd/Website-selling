---
import CompareSlider from './CompareSlider.astro';
import { pad, type WorkEntry } from '../lib/content';

// Five slides, one at a time: pick a slide, drag across it to see the rewrite.
interface Props {
  entries: WorkEntry[];
}

const examples = Astro.props.entries.filter((e) => e.data.example);
---

<div class="lab" data-lab>
  <div class="lab-tabs" role="tablist" aria-label="Choose a slide">
    {
      examples.map((e, i) => (
        <button
          type="button"
          role="tab"
          id={`lab-tab-${e.id}`}
          aria-controls={`lab-panel-${e.id}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? 0 : -1}
        >
          <span class="lab-thumb" aria-hidden="true">
            <span class="lab-thumb-head">{e.data.example!.before.headline}</span>
          </span>
          <span class="lab-tab-label">
            <span class="lab-tab-num figures">{pad(i + 1)}</span>
            {e.data.example!.slide}
          </span>
        </button>
      ))
    }
  </div>

  {
    examples.map((e, i) => (
      <div
        class="lab-panel"
        role="tabpanel"
        id={`lab-panel-${e.id}`}
        aria-labelledby={`lab-tab-${e.id}`}
        hidden={i !== 0}
      >
        <CompareSlider example={e.data.example!} />
        <div class="lab-meta">
          <p class="display lab-title">{e.data.title}</p>
          <p class="lab-dek">{e.data.dek}</p>
          <a href={`/work/${e.id}`} class="link">
            Read the analysis <span class="arrow" aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    ))
  }
</div>

<style>
  /* The tabs are the deck itself: a row of slide thumbnails, as in a presentation app */
  .lab-tabs {
    display: grid;
    grid-template-columns: repeat(5, minmax(120px, 1fr));
    gap: 14px;
    margin-bottom: 28px;
    overflow-x: auto;
    padding: 6px 2px 10px;
    scrollbar-width: none;
  }

  .lab-tabs::-webkit-scrollbar {
    display: none;
  }

  .lab-tabs button {
    display: grid;
    gap: 10px;
    padding: 0;
    background: none;
    border: 0;
    text-align: left;
    cursor: pointer;
    color: var(--ink);
  }

  .lab-thumb {
    container-type: inline-size;
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 10;
    padding: 10%;
    background: #fdfdfc;
    border: 1px solid var(--rule);
    box-shadow: 0 10px 24px -18px rgb(27 26 23 / 0.5);
    transition:
      transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1),
      box-shadow 0.35s ease,
      border-color 0.2s ease;
  }

  .lab-thumb-head {
    font: 700 clamp(8px, 9cqi, 15px) / 1.15 Arial, Helvetica, sans-serif;
    color: #2d3a4a;
    text-align: center;
  }

  .lab-tabs button:hover .lab-thumb {
    transform: translateY(-4px);
  }

  .lab-tabs button[aria-selected='true'] .lab-thumb {
    border: 2px solid var(--oxblood);
    transform: translateY(-4px);
    box-shadow: 0 18px 30px -18px rgb(122 34 34 / 0.6);
  }

  .lab-tab-label {
    display: flex;
    gap: 8px;
    align-items: baseline;
    font-family: var(--serif);
    font-style: italic;
    font-size: 1.05rem;
  }

  .lab-tab-num {
    font-family: var(--sans);
    font-style: normal;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--muted);
  }

  .lab-tabs button[aria-selected='true'] .lab-tab-label {
    color: var(--oxblood);
  }

  .lab-panel:not([hidden]) {
    animation: fade-in 0.5s ease both;
    --fd: 0s;
  }

  .lab-meta {
    display: grid;
    gap: 12px;
    justify-items: start;
    margin-top: 30px;
  }

  @media (min-width: 1000px) {
    .lab-meta {
      grid-template-columns: 5fr 5fr 2fr;
      align-items: baseline;
      gap: 40px;
    }
    .lab-meta .link {
      justify-self: end;
    }
  }

  .lab-title {
    font-size: clamp(1.6rem, 2.4vw, 2.1rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .lab-dek {
    color: var(--text);
  }
</style>
