---
import CompareSlider from './CompareSlider.astro';
import { pad, type WorkEntry } from '../lib/content';

// Five slides, one at a time: pick a slide, drag across it to see the rewrite.
interface Props {
  entries: WorkEntry[];
}

const examples = Astro.props.entries.filter((e) => e.data.example);
---

<div class="lab" data-lab>
  <div class="lab-tabs" role="tablist" aria-label="Choose a slide">
    {
      examples.map((e, i) => (
        <button
          type="button"
          role="tab"
          id={`lab-tab-${e.id}`}
          aria-controls={`lab-panel-${e.id}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? 0 : -1}
        >
          <span class="lab-tab-num figures">{pad(i + 1)}</span>
          {e.data.example!.slide}
        </button>
      ))
    }
  </div>

  {
    examples.map((e, i) => (
      <div
        class="lab-panel"
        role="tabpanel"
        id={`lab-panel-${e.id}`}
        aria-labelledby={`lab-tab-${e.id}`}
        hidden={i !== 0}
      >
        <CompareSlider example={e.data.example!} />
        <div class="lab-meta">
          <p class="display lab-title">{e.data.title}</p>
          <p class="lab-dek">{e.data.dek}</p>
          <a href={`/work/${e.id}`} class="link">
            Read the analysis <span class="arrow" aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    ))
  }
</div>

<style>
  .lab-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 26px;
  }

  .lab-tabs button {
    display: inline-flex;
    align-items: baseline;
    gap: 8px;
    padding: 9px 18px 10px;
    border: 1px solid var(--ink);
    border-radius: 999px;
    background: transparent;
    color: var(--ink);
    font-family: var(--serif);
    font-style: italic;
    font-size: 1.1rem;
    line-height: 1;
    cursor: pointer;
    transition:
      background-color 0.2s ease,
      color 0.2s ease;
  }

  .lab-tabs button:hover {
    background: var(--paper-deep);
  }

  .lab-tabs button[aria-selected='true'] {
    background: var(--ink);
    color: var(--paper);
  }

  .lab-tab-num {
    font-family: var(--sans);
    font-style: normal;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--muted);
  }

  .lab-tabs button[aria-selected='true'] .lab-tab-num {
    color: rgb(244 239 230 / 0.75);
  }

  .lab-panel:not([hidden]) {
    animation: fade-in 0.5s ease both;
    --fd: 0s;
  }

  .lab-meta {
    display: grid;
    gap: 12px;
    justify-items: start;
    margin-top: 30px;
  }

  @media (min-width: 1000px) {
    .lab-meta {
      grid-template-columns: 5fr 5fr 2fr;
      align-items: baseline;
      gap: 40px;
    }
    .lab-meta .link {
      justify-self: end;
    }
  }

  .lab-title {
    font-size: clamp(1.6rem, 2.4vw, 2.1rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .lab-dek {
    color: var(--text);
  }
</style>
