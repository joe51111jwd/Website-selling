---
// The gap, said plainly and very large. Its words light up as you read down the page (motion.ts).
const text =
  'Most decks describe the company. Few make the case for investing in it. Investors don’t fund slides. They fund an argument they can repeat to their partners on Monday morning.';
const words = text.split(' ');
---

<section class="l-statement" data-light="0.32 0.18 0.95 0.4" aria-label="The short version">
  <div class="l-wrap">
    <p class="l-statement-text" data-words>
      {
        words.map((w) => (
          <>
            <span class="w">{w}</span>{' '}
          </>
        ))
      }
    </p>
  </div>
</section>

<style>
  .l-statement {
    padding-block: clamp(120px, 16vw, 240px);
  }

  .l-statement-text {
    margin: 0;
    max-width: 18em;
    font-size: clamp(2.1rem, 4.9vw, 4.75rem);
    font-weight: 600;
    line-height: 1.04;
    letter-spacing: -0.042em;
    color: var(--fg);
  }

  .w {
    transition: color 0.6s ease;
  }

  :global(.js) .w {
    color: rgb(246 242 236 / 0.42);
  }

  :global(.js) .w.on {
    color: var(--fg);
  }
</style>
