---
// The top of an inner page: a small line, the title very large, and (unless drops is false) a few
// drops of liquid glass drifting over it, the same as the home page's opener at a smaller scale.
// The title is split into words so the renderer can set each one where the page does; the words
// in `dim` follow on in a quieter tone.
interface Props {
  eyebrow?: string;
  title: string;
  dim?: string;
  drops?: boolean;
  light?: string;
  id?: string;
}

const { eyebrow, title, dim, drops = true, light = '0.9 0.84 0.42 -0.6', id = 'page-title' } = Astro.props;
const words = [
  ...title.split(' ').map((w) => [w, 'hw']),
  ...(dim ? dim.split(' ').map((w) => [w, 'hw hw--dim']) : []),
];
---

<header class="l-head" data-drops={drops ? 'head' : undefined} data-light={light}>
  <div class="l-wrap">
    <p class="l-eyebrow l-rise" style="--d: 0.05s">
      {Astro.slots.has('eyebrow') ? <slot name="eyebrow" /> : eyebrow}
    </p>
    <h1 id={id} class="l-head-title" data-headline={drops ? '' : undefined}>
      {
        words.map(([w, cls]) => (
          <>
            <span class={cls}>{w}</span>{' '}
          </>
        ))
      }
    </h1>
    {
      Astro.slots.has('lead') && (
        <p class="l-lead l-head-lead l-rise" style="--d: 0.3s">
          <slot name="lead" />
        </p>
      )
    }
    <slot />
  </div>
</header>
