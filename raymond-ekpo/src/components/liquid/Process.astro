---
// How an engagement runs, as four tall glass panels that slide sideways while the section holds
// still. On phones, or with reduced motion, they simply stack.
const steps = [
  {
    title: 'Enquiry',
    when: 'Day 0',
    body: 'Tell me about the company, the round and where the story feels weak. Share the deck if you have one.',
  },
  {
    title: 'First read',
    when: 'Within two business days',
    body: 'I read everything myself and reply with a straight answer: whether I can help, which service fits, or whether you need me at all yet.',
  },
  {
    title: 'The narrative',
    when: 'The work',
    body: 'We agree the thesis in writing, then build or rebuild the storyline and the slides around it.',
  },
  {
    title: 'The room',
    when: 'The raise',
    body: 'You walk in able to explain the company and defend it. With Q&A preparation, you’ve already rehearsed the hard questions.',
  },
];
---

<section class="l-proc" data-proc data-light="0.7 0.3 0.75 -0.2" aria-labelledby="proc-title">
  <div class="l-proc-stage">
    <div class="l-wrap l-proc-head">
      <p class="l-eyebrow">How it works</p>
      <h2 id="proc-title" class="l-h2">From first message <span class="l-dim">to the room.</span></h2>
    </div>
    <ol class="l-proc-track" data-proc-track>
      {
        steps.map((s, i) => (
          <li class="l-proc-card">
            <span class="l-proc-n" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <p class="l-proc-when">{s.when}</p>
            <h3 class="l-proc-title">{s.title}</h3>
            <p class="l-proc-body">{s.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<script>
  import { onScroll, pinProgress, still } from '../../scripts/fx/frame';

  const root = document.querySelector<HTMLElement>('[data-proc]');
  const track = root?.querySelector<HTMLElement>('[data-proc-track]');
  const wide = matchMedia('(min-width: 1000px)');
  if (root && track && !still) {
    onScroll(() => {
      if (!wide.matches) {
        track.style.transform = '';
        return;
      }
      const travel = track.scrollWidth - track.clientWidth;
      track.style.transform = `translateX(${-pinProgress(root) * travel}px)`;
    });
  }
</script>

<style>
  .l-proc {
    position: relative;
    padding-block: clamp(80px, 10vw, 140px);
  }

  .l-proc-head {
    display: grid;
    gap: 22px;
  }

  .l-proc-track {
    list-style: none;
    margin: clamp(40px, 5vw, 64px) 0 0;
    padding: 0 var(--gutter);
    display: grid;
    gap: 16px;
  }

  .l-proc-card {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 300px;
    padding: 30px;
    border-radius: 36px;
    background: var(--glass);
    -webkit-backdrop-filter: blur(28px) saturate(1.8);
    backdrop-filter: blur(28px) saturate(1.8);
    box-shadow: var(--glass-rim), var(--glass-drop);
    overflow: hidden;
  }

  .l-proc-n {
    position: absolute;
    right: 18px;
    top: -0.08em;
    font-size: clamp(7rem, 12vw, 11rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.06em;
    color: transparent;
    -webkit-text-stroke: 1px rgb(246 242 236 / 0.16);
    font-variant-numeric: tabular-nums;
  }

  .l-proc-when {
    margin: 0;
    color: var(--ember-soft);
    font-size: 0.86rem;
    font-weight: 500;
  }

  .l-proc-title {
    margin: auto 0 0;
    padding-top: 80px;
    font-size: clamp(1.9rem, 3vw, 2.8rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1;
    color: var(--fg);
  }

  .l-proc-body {
    margin: 14px 0 0;
    max-width: 24em;
    color: var(--fg-2);
    line-height: 1.55;
  }

  /* wide screens: the section holds still while the cards slide past */
  @media (min-width: 1000px) {
    :global(.js:not(.still)) .l-proc {
      height: 260vh;
      padding: 0;
    }
    :global(.js:not(.still)) .l-proc-stage {
      position: sticky;
      top: 0;
      height: 100vh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      overflow: hidden;
    }
    .l-proc-track {
      display: flex;
      gap: 20px;
      padding-inline: max(var(--gutter), calc((100vw - var(--wrap)) / 2 + var(--gutter)));
      will-change: transform;
    }
    .l-proc-card {
      flex: 0 0 min(44vw, 560px);
      min-height: min(56vh, 520px);
      padding: 38px;
    }
  }
</style>
