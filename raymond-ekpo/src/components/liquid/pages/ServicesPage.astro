---
// The services page in the glass build: the four engagements side by side, the fit check, then
// each one in full under a glass bar that tracks where you are, the mini-audit and the questions
// people ask before they enquire. The page file (src/pages/services.astro) holds the data and the
// structured data for both builds.
import { render } from 'astro:content';
import type { Service } from '../../../lib/content';
import { pad } from '../../../lib/content';
import PageHead from '../PageHead.astro';
import Services from '../Services.astro';
import Plan from '../Plan.astro';

interface Props {
  services: Service[];
  faqs: { q: string; a: string }[];
}

const { services, faqs } = Astro.props;
const rendered = await Promise.all(services.map((s) => render(s)));
const short: Record<string, string> = {
  rewrite: 'Rewrite',
  creation: 'New deck',
  'qa-prep': 'Q&A prep',
  'investor-research': 'Research',
};
const lights = ['0.8 0.86 0.3 -0.8', '0.75 0.8 0.75 0.5', '0.7 0.9 0.45 -0.2', '0.8 0.82 0.7 0.9'];
---

<PageHead eyebrow="Services" title="Four engagements." dim="Each with a clear end.">
  <Fragment slot="lead">
    Fixed scopes and public prices. Each one starts from the investment case and ends with something you can take into
    your next investor meeting.
  </Fragment>
</PageHead>

<Services head={false} audit={false} />

<Plan />

<div class="l-sd-wrap">
  <nav class="l-local" aria-label="On this page" data-local>
    <div class="l-local-in" data-seg="current">
      <span class="l-local-thumb" data-seg-thumb aria-hidden="true"></span>
      {
        services.map((s) => (
          <a href={`#${s.id}`} class="l-local-item" data-seg-item>
            {short[s.id] ?? s.data.title}
          </a>
        ))
      }
      <a href="#mini-audit" class="l-local-item" data-seg-item>Mini-audit</a>
      <a href="#faq" class="l-local-item" data-seg-item>Questions</a>
    </div>
  </nav>

  {
    services.map((s, i) => {
      const { Content } = rendered[i];
      return (
        <section id={s.id} class="l-sd" data-light={lights[i % lights.length]} aria-labelledby={`${s.id}-title`}>
          <div class="l-wrap l-sd-grid">
            <div class="l-sd-side">
              <p class="l-eyebrow">
                {pad(i + 1)} / {pad(services.length)}
              </p>
              <h2 id={`${s.id}-title`} class="l-sd-title">
                {s.data.title}
              </h2>
              <p class="l-sd-price">{s.data.price}</p>
              <p class="l-sd-note">{s.data.priceNote}</p>
              <a
                href={`/work-with-me?service=${s.id}`}
                class="l-btn l-btn--primary"
                data-cta={s.data.cta}
                data-cta-location="services page"
              >
                {s.data.cta}
              </a>
            </div>

            <div class="l-sd-main">
              <p class="l-sd-best">
                <span class="l-eyebrow">Best for</span>
                {s.data.bestFor}
              </p>
              <div class="prose l-sd-prose">
                <Content />
              </div>
              <div class="l-sd-lists">
                <div class="l-panel">
                  <h3 class="l-panel-h">What it covers</h3>
                  <ul class="l-checks">
                    {s.data.covers.map((c) => (
                      <li>{c}</li>
                    ))}
                  </ul>
                </div>
                <div class="l-panel">
                  <h3 class="l-panel-h">What you receive</h3>
                  <ul class="l-checks">
                    {s.data.receive.map((c) => (
                      <li>{c}</li>
                    ))}
                  </ul>
                </div>
              </div>
              <div class="l-sd-needs">
                <h3 class="l-eyebrow">What I need from you</h3>
                <p>{s.data.needs}</p>
              </div>
              {s.data.note && <p class="l-sd-fine">{s.data.note}</p>}
            </div>
          </div>
        </section>
      );
    })
  }

  <section id="mini-audit" class="l-mini" data-light="1.05 0.5 0.6 0.2" aria-labelledby="audit-title">
    <div class="l-wrap">
      <div class="l-mini-card">
        <div>
          <span class="l-tag l-tag--ember">Complimentary</span>
          <h2 id="audit-title" class="l-h2 l-mini-title">The <span class="l-nowrap">mini-audit.</span></h2>
        </div>
        <div class="l-mini-body">
          <p class="l-lead">
            If you already have a deck, send it over and I’ll write back with a short note on the three changes I’d make
            first, and why. No call needed, and no obligation to work together afterwards.
          </p>
          <p class="l-mini-fine">
            I only do a few each month, for founders raising pre-seed or seed in the next six months, so I may decline if
            it isn’t a fit or the month is full. I’ll tell you either way.
          </p>
          <a
            href="/work-with-me?type=audit"
            class="l-btn l-btn--primary l-btn--lg"
            data-cta="Request a free deck audit"
            data-cta-location="services page"
          >
            Request a mini-audit
          </a>
        </div>
      </div>
    </div>
  </section>

  <section id="faq" class="l-faq" data-light="0.45 0.2 0.85 -0.4" aria-labelledby="faq-title">
    <div class="l-wrap l-faq-grid">
      <div>
        <p class="l-eyebrow">Questions</p>
        <h2 id="faq-title" class="l-h2 l-faq-title">Before you <span class="l-dim">enquire.</span></h2>
      </div>
      <div class="l-faq-list">
        {
          faqs.map((f, i) => (
            <details class="l-qa" open={i === 0}>
              <summary>
                <span>{f.q}</span>
                <span class="l-qa-icon" aria-hidden="true" />
              </summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>
</div>

<script>
  // The bar's thumb rests on whichever part of the page you're reading.
  import { onScroll } from '../../../scripts/fx/frame';

  const nav = document.querySelector<HTMLElement>('[data-local]');
  const group = nav?.querySelector<HTMLElement>('[data-seg]');
  if (nav && group) {
    const links = [...group.querySelectorAll<HTMLAnchorElement>('[data-seg-item]')];
    const targets = links.map((a) => document.getElementById(a.hash.slice(1)));
    let current = -1;
    onScroll(() => {
      const line = innerHeight * 0.35;
      let i = -1;
      targets.forEach((t, k) => {
        if (t && t.getBoundingClientRect().top <= line) i = k;
      });
      if (i === current) return;
      current = i;
      links.forEach((a, k) => {
        a.classList.toggle('is-current', k === i);
        if (k === i) a.setAttribute('aria-current', 'location');
        else a.removeAttribute('aria-current');
      });
      // on a phone the bar scrolls sideways: keep the current part in view
      const a = links[i];
      if (a && nav.scrollWidth > nav.clientWidth) {
        nav.scrollTo({ left: a.offsetLeft - (nav.clientWidth - a.offsetWidth) / 2, behavior: 'smooth' });
      }
      group.dispatchEvent(new Event('seg:sync'));
    });
  }
</script>

<style>
  .l-sd-wrap {
    position: relative;
  }

  /* the bar that tracks where you are */
  .l-local {
    position: sticky;
    top: 80px;
    z-index: 20;
    display: flex;
    width: fit-content;
    max-width: calc(100% - 2 * var(--gutter));
    margin: 0 auto;
    overflow-x: auto;
    scrollbar-width: none;
    border-radius: 999px;
    background: rgb(28 22 20 / 0.5);
    -webkit-backdrop-filter: blur(20px) saturate(1.9);
    backdrop-filter: blur(20px) saturate(1.9);
    box-shadow: var(--glass-rim), var(--glass-drop);
  }

  .l-local::-webkit-scrollbar {
    display: none;
  }

  .l-local-in {
    position: relative;
    display: flex;
    flex: none;
    gap: 2px;
    padding: 5px;
  }

  .l-local-thumb {
    position: absolute;
    left: 0;
    top: 0;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.14);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.35),
      inset 0 0 0 1px rgb(255 255 255 / 0.1);
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }

  .l-local-thumb:global(.on) {
    opacity: 1;
  }

  .l-local-item {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    min-height: 38px;
    padding: 0 16px;
    border-radius: 999px;
    color: var(--fg-2);
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.3s ease;
  }

  .l-local-item:global(.is-current),
  .l-local-item:global(.is-lit) {
    color: var(--fg);
  }

  /* each engagement in full */
  .l-sd {
    padding-block: clamp(90px, 11vw, 160px) 0;
    scroll-margin-top: 60px;
  }

  .l-sd-grid {
    display: grid;
    gap: 40px;
  }

  @media (min-width: 1000px) {
    .l-sd-grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: 72px;
    }
    .l-sd-side {
      position: sticky;
      top: 150px;
      align-self: start;
    }
  }

  .l-sd-side {
    display: grid;
    justify-items: start;
    align-content: start;
  }

  .l-sd-title {
    margin: 18px 0 0;
    max-width: 9em;
    font-size: clamp(2.4rem, 4.6vw, 4.4rem);
    font-weight: 600;
    line-height: 0.98;
    letter-spacing: -0.045em;
    color: var(--fg);
    text-wrap: balance;
  }

  .l-sd-price {
    margin: 28px 0 0;
    font-size: clamp(2.6rem, 4.4vw, 4rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.05em;
    font-variant-numeric: tabular-nums;
    background: linear-gradient(100deg, #fff6ef 10%, var(--ember-soft) 60%, var(--ember) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .l-sd-note {
    margin: 10px 0 28px;
    color: var(--fg-3);
    font-size: 0.95rem;
  }

  .l-sd-best {
    display: grid;
    gap: 12px;
    margin: 0;
    max-width: 30em;
    font-size: clamp(1.3rem, 1.9vw, 1.7rem);
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.02em;
    color: var(--fg);
  }

  .l-sd-prose {
    margin-top: 32px;
  }

  .l-sd-lists {
    display: grid;
    gap: 16px;
    margin-top: 44px;
  }

  @media (min-width: 760px) {
    .l-sd-lists {
      grid-template-columns: 1fr 1fr;
    }
  }

  .l-sd-needs {
    display: grid;
    gap: 10px;
    margin-top: 36px;
    padding-left: 18px;
    border-left: 2px solid var(--ember);
  }

  .l-sd-needs p {
    margin: 0;
    max-width: 36em;
    color: var(--fg);
  }

  .l-sd-fine {
    margin: 22px 0 0;
    max-width: 38em;
    font-size: 0.94rem;
    color: var(--fg-3);
  }

  /* the mini-audit */
  .l-mini {
    padding-block: clamp(110px, 13vw, 180px) 0;
    scroll-margin-top: 60px;
  }

  .l-mini-card {
    display: grid;
    gap: 36px;
    padding: clamp(30px, 5vw, 64px);
    border-radius: clamp(30px, 4vw, 48px);
    background:
      radial-gradient(80% 90% at 100% 0%, rgb(255 106 61 / 0.32), transparent 60%),
      radial-gradient(60% 80% at 0% 100%, rgb(140 26 14 / 0.4), transparent 70%),
      rgb(30 22 19 / 0.42);
    -webkit-backdrop-filter: blur(30px) saturate(1.9);
    backdrop-filter: blur(30px) saturate(1.9);
    box-shadow: var(--glass-rim), var(--glass-drop);
  }

  @media (min-width: 1000px) {
    .l-mini-card {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: 64px;
    }
  }

  .l-mini-title {
    margin-top: 22px;
    font-size: clamp(2.6rem, 5vw, 4.8rem);
  }

  .l-nowrap {
    white-space: nowrap;
  }

  .l-mini-body {
    display: grid;
    gap: 22px;
    justify-items: start;
    align-content: start;
  }

  .l-mini-fine {
    margin: 0;
    max-width: 36em;
    font-size: 0.95rem;
    color: var(--fg-3);
  }

  /* questions */
  .l-faq {
    padding-block: clamp(110px, 13vw, 180px) clamp(20px, 4vw, 60px);
    scroll-margin-top: 60px;
  }

  .l-faq-grid {
    display: grid;
    gap: 40px;
  }

  @media (min-width: 1000px) {
    .l-faq-grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: 72px;
    }
  }

  .l-faq-title {
    margin-top: 22px;
  }

  .l-faq-list {
    display: grid;
    gap: 10px;
  }

  .l-qa {
    border-radius: 26px;
    background: var(--glass);
    -webkit-backdrop-filter: blur(24px) saturate(1.8);
    backdrop-filter: blur(24px) saturate(1.8);
    box-shadow: var(--glass-rim), 0 18px 40px -26px rgb(0 0 0 / 0.8);
    transition: background-color 0.3s ease;
  }

  .l-qa[open] {
    background-color: rgb(40 30 26 / 0.5);
  }

  .l-qa summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    padding: 22px 24px;
    list-style: none;
    cursor: pointer;
    color: var(--fg);
    font-size: 1.12rem;
    font-weight: 500;
    letter-spacing: -0.015em;
  }

  .l-qa summary::-webkit-details-marker {
    display: none;
  }

  .l-qa-icon {
    position: relative;
    flex: none;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.08);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.2);
    transition: transform 0.45s var(--ease);
  }

  .l-qa-icon::before,
  .l-qa-icon::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 12px;
    height: 1.6px;
    margin: -0.8px 0 0 -6px;
    border-radius: 2px;
    background: var(--fg);
  }

  .l-qa-icon::after {
    transform: rotate(90deg);
    transition: transform 0.45s var(--ease);
  }

  .l-qa[open] .l-qa-icon {
    transform: rotate(180deg);
  }

  .l-qa[open] .l-qa-icon::after {
    transform: rotate(0deg);
  }

  .l-qa p {
    margin: 0;
    padding: 0 24px 24px;
    max-width: 40em;
    color: var(--fg-2);
  }
</style>
