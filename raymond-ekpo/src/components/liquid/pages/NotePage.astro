---
// A note or case study in the glass build: the title under the drops, the slide it's about with a
// switch between the version founders usually write (before) and the rewrite (after), the argument, and the next
// note. The switch is radio buttons and CSS, like the cards on the home page.
import { render } from 'astro:content';
import type { WorkEntry } from '../../../lib/content';
import { readingMinutes } from '../../../lib/content';
import PageHead from '../PageHead.astro';

interface Props {
  entry: WorkEntry;
  next: WorkEntry;
}

const { entry, next } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const isCase = d.kind === 'case-study';
const date = d.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
const facts = isCase
  ? ([
      ['Client', d.client],
      ['Stage', d.stage],
      ['Sector', d.sector],
      ['Outcome', d.outcome],
    ].filter(([, v]) => v) as [string, string][])
  : [];
---

<article>
  <PageHead title={d.title} id="note-title" light="0.85 0.86 0.38 -0.55">
    <Fragment slot="eyebrow">
      <a href="/work" class="l-crumb">Work</a> <span aria-hidden="true">/</span>
      {d.topic}
    </Fragment>
    <Fragment slot="lead">{d.dek}</Fragment>
    <p class="l-note-meta l-rise" style="--d: 0.4s">
      <time datetime={d.date.toISOString()}>{date}</time>
      <span aria-hidden="true">·</span>
      <span>{readingMinutes(entry.body)} min read</span>
      {d.illustrative && <span class="l-tag">Illustrative example</span>}
    </p>
  </PageHead>

  {
    facts.length > 0 && (
      <div class="l-wrap">
        <dl class="l-facts">
          {facts.map(([k, v]) => (
            <div>
              <dt>{k}</dt>
              <dd>{v}</dd>
            </div>
          ))}
        </dl>
      </div>
    )
  }

  {
    d.example && (
      <section class="l-wrap l-ex" data-light="0.7 0.75 0.55 0.3" aria-label={`The ${d.example.slide.toLowerCase()} slide, before and after`}>
        <div class="l-ex-bar">
          <fieldset class="l-seg l-ex-seg" data-seg="checked">
            <legend class="sr-only">Show the slide</legend>
            <span class="l-seg-thumb" data-seg-thumb aria-hidden="true" />
            <label class="l-seg-item" data-seg-item>
              <input type="radio" name={`ex-${entry.id}`} value="before" checked />
              <span>Before</span>
            </label>
            <label class="l-seg-item" data-seg-item>
              <input type="radio" name={`ex-${entry.id}`} value="after" />
              <span>After</span>
            </label>
          </fieldset>
          {d.illustrative && <p class="l-ex-fig">Illustrative. The company, numbers and events are invented to show the reasoning.</p>}
        </div>
        <div class="l-ex-frame">
          <div class="l-slide l-slide--before" data-surface="light">
            <p class="l-slide-head">{d.example.before.headline}</p>
            <ul>
              {d.example.before.points.map((p) => (
                <li>{p}</li>
              ))}
            </ul>
          </div>
          <div class="l-slide l-slide--after">
            <p class="l-slide-label">{d.example.slide}</p>
            <p class="l-slide-head">{d.example.after.headline}</p>
            <ol>
              {d.example.after.points.map((p) => (
                <li>{p}</li>
              ))}
            </ol>
          </div>
        </div>
      </section>
    )
  }

  <div class="l-wrap l-note-body" data-light="0.4 0.15 0.8 -0.3">
    <div class="prose">
      <Content />
    </div>

    <aside class="l-note-cta" aria-label="Work with me">
      <p class="l-eyebrow">Does your deck do this?</p>
      <p class="l-note-cta-title">Send it over for a complimentary mini-audit.</p>
      <p>I’ll write back with the three changes I’d make first.</p>
      <a href="/work-with-me?type=audit" class="l-btn l-btn--primary" data-cta="Request a free deck audit" data-cta-location={`note: ${entry.id}`}>
        Request a mini-audit
      </a>
    </aside>
  </div>

  {
    next.id !== entry.id && (
      <nav class="l-wrap l-next" aria-label="Next note">
        <a href={`/work/${next.id}`} class="l-next-link">
          <span class="l-eyebrow">Next · {next.data.topic}</span>
          <span class="l-next-title">{next.data.title}</span>
          <span class="l-next-arrow" aria-hidden="true">
            →
          </span>
        </a>
      </nav>
    )
  }
</article>

<style>
  .l-crumb {
    color: var(--fg);
    text-decoration: none;
  }

  .l-crumb:hover {
    color: var(--ember-soft);
  }

  .l-note-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 12px;
    margin: 26px 0 0;
    font-size: 0.92rem;
    color: var(--fg-3);
  }

  .l-facts {
    display: grid;
    margin: 0 0 48px;
    border-radius: 28px;
    background: var(--glass);
    -webkit-backdrop-filter: blur(24px) saturate(1.8);
    backdrop-filter: blur(24px) saturate(1.8);
    box-shadow: var(--glass-rim);
  }

  @media (min-width: 760px) {
    .l-facts {
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    }
  }

  .l-facts div {
    padding: 20px 24px;
  }

  .l-facts dt {
    font-size: 0.8rem;
    color: var(--fg-3);
  }

  .l-facts dd {
    margin: 4px 0 0;
    color: var(--fg);
  }

  /* the slide, before and after */
  .l-ex {
    padding-bottom: clamp(70px, 9vw, 120px);
  }

  .l-ex-bar {
    display: grid;
    gap: 14px;
    margin-bottom: 18px;
  }

  @media (min-width: 900px) {
    .l-ex-bar {
      grid-template-columns: auto 1fr;
      align-items: center;
      gap: 28px;
    }
  }

  .l-ex-seg {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    min-width: min(100%, 300px);
  }

  .l-ex-fig {
    margin: 0;
    font-size: 0.88rem;
    color: var(--fg-3);
  }

  .l-ex-frame {
    container-type: inline-size;
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: clamp(18px, 2.4vw, 30px);
    overflow: hidden;
    box-shadow: var(--glass-rim), 0 40px 80px -40px rgb(0 0 0 / 0.9);
  }

  @media (max-width: 640px) {
    .l-ex-frame {
      aspect-ratio: 4 / 4.2;
    }
  }

  .l-slide {
    position: absolute;
    inset: 0;
    padding: 7cqi 8cqi;
    transition:
      opacity 0.6s var(--ease),
      transform 0.8s var(--ease),
      filter 0.6s var(--ease);
  }

  .l-slide ul,
  .l-slide ol {
    margin: 0;
    padding: 0;
  }

  /* the deck as it usually arrives: centred, generic, bulleted */
  .l-slide--before {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    background: #e6e3de;
    color: #4f4f4f;
    font-family: Arial, Helvetica, sans-serif;
    letter-spacing: 0;
  }

  .l-slide--before .l-slide-head {
    margin: 0 0 4.5cqi;
    font-size: clamp(18px, 5.2cqi, 44px);
    font-weight: 700;
    line-height: 1.15;
    color: #2d3a4a;
  }

  .l-slide--before ul {
    text-align: left;
    padding-left: 1.1em;
  }

  .l-slide--before li {
    font-size: clamp(13px, 2.6cqi, 21px);
    line-height: 1.45;
  }

  .l-slide--before li + li {
    margin-top: 1.2cqi;
  }

  /* the rewrite: the headline makes the claim, the points prove it */
  .l-slide--after {
    display: flex;
    flex-direction: column;
    justify-content: center;
    background:
      radial-gradient(70% 90% at 100% 100%, rgb(255 106 61 / 0.3), transparent 60%),
      radial-gradient(60% 70% at 0% 0%, rgb(120 22 12 / 0.45), transparent 70%),
      #120d0b;
    color: var(--fg-2);
  }

  .l-slide-label {
    margin: 0 0 2.6cqi;
    font-size: clamp(10px, 1.6cqi, 13px);
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ember-soft);
  }

  .l-slide--after .l-slide-head {
    margin: 0 0 4cqi;
    max-width: 20em;
    font-size: clamp(19px, 4.6cqi, 42px);
    font-weight: 600;
    line-height: 1.04;
    letter-spacing: -0.04em;
    color: var(--fg);
    text-wrap: balance;
  }

  .l-slide--after ol {
    list-style: none;
    counter-reset: pt;
  }

  .l-slide--after li {
    counter-increment: pt;
    display: grid;
    grid-template-columns: 2.4em 1fr;
    padding: 1.5cqi 0;
    border-top: 1px solid rgb(246 242 236 / 0.14);
    font-size: clamp(12px, 2.2cqi, 19px);
    line-height: 1.4;
  }

  .l-slide--after li::before {
    content: counter(pt, decimal-leading-zero);
    color: var(--ember-soft);
    font-variant-numeric: tabular-nums;
  }

  /* which one shows: the checked radio decides */
  .l-ex:has(input[value='before']:checked) .l-slide--after,
  .l-ex:has(input[value='after']:checked) .l-slide--before {
    opacity: 0;
    transform: scale(1.03);
    filter: blur(8px);
    pointer-events: none;
  }

  .l-ex:has(input[value='after']:checked) .l-slide--before {
    transform: scale(0.97);
  }

  @media (prefers-reduced-motion: reduce) {
    .l-slide {
      transition: none;
    }
  }

  /* the argument */
  .l-note-body {
    display: grid;
    gap: 56px;
  }

  @media (min-width: 1000px) {
    .l-note-body {
      grid-template-columns: minmax(0, 8fr) minmax(0, 4fr);
      gap: 64px;
    }
    .l-note-body .prose {
      margin-left: calc(100% / 8);
    }
    .l-note-cta {
      position: sticky;
      top: 100px;
      align-self: start;
    }
  }

  .l-note-cta {
    display: grid;
    gap: 14px;
    justify-items: start;
    padding: 28px;
    border-radius: 30px;
    background:
      radial-gradient(90% 70% at 100% 0%, rgb(255 106 61 / 0.22), transparent 60%),
      var(--glass);
    -webkit-backdrop-filter: blur(28px) saturate(1.8);
    backdrop-filter: blur(28px) saturate(1.8);
    box-shadow: var(--glass-rim), var(--glass-drop);
  }

  .l-note-cta p {
    margin: 0;
  }

  .l-note-cta-title {
    font-size: 1.55rem;
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.035em;
    color: var(--fg);
  }

  .l-next {
    margin-top: clamp(90px, 11vw, 150px);
  }

  .l-next-link {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 12px 24px;
    padding: clamp(26px, 4vw, 44px);
    border-radius: 36px;
    background: var(--glass);
    -webkit-backdrop-filter: blur(28px) saturate(1.8);
    backdrop-filter: blur(28px) saturate(1.8);
    box-shadow: var(--glass-rim), var(--glass-drop);
    color: var(--fg);
    text-decoration: none;
    transition: transform 0.6s var(--ease);
  }

  .l-next-link:hover {
    transform: translateY(-4px);
  }

  .l-next-link .l-eyebrow {
    grid-column: 1 / -1;
  }

  .l-next-title {
    font-size: clamp(1.8rem, 3.6vw, 3.2rem);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }

  .l-next-arrow {
    display: grid;
    place-items: center;
    align-self: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: rgb(250 246 240 / 0.94);
    color: #0d0a09;
    font-size: 1.4rem;
    transition: transform 0.5s var(--ease);
  }

  .l-next-link:hover .l-next-arrow {
    transform: translateX(6px);
  }
</style>
