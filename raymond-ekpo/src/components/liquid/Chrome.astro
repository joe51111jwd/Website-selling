---
// The floating chrome: the name and the main action up top, and a glass tab bar along the bottom
// of the screen, the way iOS lays out an app. The tab bar's glass lens rests on the current page
// and follows the pointer (segments.ts); it tucks itself smaller while you read (tabs.ts).
import { site } from '../../site.config';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const tabs = [
  { href: '/', label: 'Home', icon: 'home' },
  { href: '/services', label: 'Services', icon: 'services' },
  { href: '/work', label: 'Work', icon: 'work' },
  { href: '/about', label: 'About', icon: 'about' },
  { href: '/work-with-me', label: 'Enquire', icon: 'enquire' },
];
const current = (href: string) => (href === '/' ? path === '/' : path === href || path.startsWith(href + '/'));
---

<header class="l-top" data-topbar>
  <div class="l-wrap l-top-in">
    <a href="/" class="l-mark" aria-label={`${site.name}, home`}>
      <span class="l-mark-dot" aria-hidden="true"></span>
      <span class="l-mark-name">{site.name}</span>
      <span class="l-mark-role">{site.role}</span>
    </a>
    <a
      href="/work-with-me"
      class="l-btn l-btn--sm l-btn--primary"
      data-lens-glass="2"
      data-cta="Discuss your raise"
      data-cta-location="header">Discuss your raise</a
    >
  </div>
</header>

<nav class="l-tabbar" data-tabbar aria-label="Main">
  <div class="l-tabs" data-seg="current" data-lens-glass="7">
    <span class="l-tab-thumb" data-seg-thumb aria-hidden="true"></span>
    {
      tabs.map((t) => (
        <a href={t.href} class="l-tab" data-seg-item aria-current={current(t.href) ? 'page' : undefined}>
          <svg class="l-tab-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            {t.icon === 'home' && <path d="M4 10.5 12 4l8 6.5V19a1 1 0 0 1-1 1h-4.5v-5.5h-5V20H5a1 1 0 0 1-1-1Z" />}
            {t.icon === 'services' && (
              <>
                <path d="M12 3.5 21 8l-9 4.5L3 8Z" />
                <path d="m3 12 9 4.5 9-4.5" />
                <path d="m3 16 9 4.5 9-4.5" />
              </>
            )}
            {t.icon === 'work' && (
              <>
                <rect x="4" y="5" width="16" height="11" rx="2" />
                <path d="M9 20h6M12 16v4" />
              </>
            )}
            {t.icon === 'about' && (
              <>
                <circle cx="12" cy="8.5" r="3.6" />
                <path d="M4.8 20c.9-3.6 3.7-5.6 7.2-5.6s6.3 2 7.2 5.6" />
              </>
            )}
            {t.icon === 'enquire' && <path d="M4 12.5 20 4l-4.5 16-3.8-6.3Zm7.7 1.2L20 4" />}
          </svg>
          <span class="l-tab-label">{t.label}</span>
        </a>
      ))
    }
  </div>
</nav>
