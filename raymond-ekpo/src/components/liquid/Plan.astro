---
// The fit check as a plan you build: five answers on liquid segmented controls, and a glass pass
// that fills in beside them with the engagements that fit, in order, and what they cost. The
// logic is fit.ts, shared with the paper version, so the hooks (data-fit-*) stay the same.
import { getServices } from '../../lib/content';
import { site } from '../../site.config';

const services = (await getServices()).map((s) => ({
  id: s.id,
  title: s.data.title,
  price: s.data.price,
  min: s.data.priceMin,
  max: s.data.priceMax,
}));

const questions = [
  { id: 'round', label: 'Which round are you raising?', options: [['pre-seed', 'Pre-seed'], ['seed', 'Seed'], ['later', 'Series A+']] },
  { id: 'deck', label: 'Do you have a deck that needs work?', options: [['yes', 'Yes'], ['no', 'Not yet']] },
  { id: 'meetings', label: 'Are investor meetings booked?', options: [['booked', 'Booked'], ['not-yet', 'Not yet']] },
  { id: 'list', label: 'Do you know who to pitch?', options: [['yes', 'I have a list'], ['no', 'Not really']] },
  { id: 'timing', label: 'When do conversations start?', options: [['now', '< 3 months'], ['soon', '3–6 months'], ['later', 'Later']] },
];
---

<section class="l-plan" data-light="0.85 0.92 0.5 0.6" aria-labelledby="plan-title">
  <div class="l-wrap">
    <div class="l-plan-head">
      <p class="l-eyebrow">Fit check</p>
      <h2 id="plan-title" class="l-h2">Five answers. <span class="l-dim">Your plan, priced.</span></h2>
      <p class="l-lead">
        Tell me where the raise stands and the plan writes itself: which engagements fit, in what order, and what they
        cost. If I’m not the right person, it says so.
      </p>
    </div>

    <div class="l-plan-grid" data-fit data-services={JSON.stringify(services)} data-email={site.email}>
      <form class="l-qs" aria-label="Fit check">
        {
          questions.map((q, i) => (
            <fieldset class="l-q">
              <legend class="l-q-label">
                <span class="l-q-n">{i + 1}</span>
                {q.label}
              </legend>
              <div class="l-seg l-seg--wide" data-seg="checked">
                <span class="l-seg-thumb" data-seg-thumb aria-hidden="true" />
                {q.options.map(([value, label]) => (
                  <label class="l-seg-item" data-seg-item>
                    <input type="radio" name={q.id} value={value} />
                    <span>{label}</span>
                  </label>
                ))}
              </div>
            </fieldset>
          ))
        }
        <a href="#plan-pass" class="l-plan-mini" data-fit-mini hidden aria-hidden="true" tabindex="-1">
          <span data-fit-mini-title></span>
          <span class="l-plan-mini-sum" data-fit-mini-sum></span>
        </a>
      </form>

      <aside class="l-pass" id="plan-pass" aria-live="polite" aria-label="Your plan">
        <div class="l-pass-top">
          <span class="l-pass-brand"><span class="l-mark-dot" aria-hidden="true"></span> Your plan</span>
          <span class="l-pass-status" data-fit-status>Draft · 0 of 5</span>
        </div>
        <p class="l-pass-title" data-fit-title>Answer the questions to draft it.</p>
        <div class="l-pass-tear" aria-hidden="true"></div>
        <ol class="l-pass-lines" data-fit-lines>
          <li class="fit-line fit-line--ghost"><span></span><span></span></li>
          <li class="fit-line fit-line--ghost"><span></span><span></span></li>
          <li class="fit-line fit-line--ghost"><span></span><span></span></li>
        </ol>
        <div class="l-pass-total" data-fit-total hidden>
          <span>Indicative fee</span>
          <span class="l-pass-sum" data-fit-sum></span>
        </div>
        <p class="l-pass-verdict" data-fit-verdict>
          Each answer adds or removes a line. Nothing is sent anywhere until you choose to get in touch.
        </p>
        <div class="l-pass-ctas" data-fit-ctas hidden>
          <a href="/work-with-me" class="l-btn l-btn--primary" data-fit-go data-cta="Fit check: discuss" data-cta-location="fit check">Discuss this </a>
          <a href="/work-with-me?type=audit" class="l-pass-audit" data-fit-audit hidden data-cta="Request a free deck audit" data-cta-location="fit check">Or start with a free mini-audit</a>
        </div>
      </aside>
    </div>
  </div>
</section>

<style>
  .l-plan {
    padding-block: clamp(100px, 12vw, 180px) clamp(60px, 8vw, 110px);
  }

  .l-plan-head {
    display: grid;
    gap: 22px;
  }

  .l-plan-head .l-h2 {
    max-width: 12em;
  }

  .l-plan-grid {
    display: grid;
    gap: 28px;
    margin-top: clamp(40px, 5vw, 64px);
  }

  @media (min-width: 1000px) {
    .l-plan-grid {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: 40px;
      align-items: start;
    }
    .l-pass {
      position: sticky;
      top: 96px;
    }
  }

  .l-qs {
    display: grid;
    gap: 6px;
    padding: 10px 26px;
    border-radius: 34px;
    background: var(--glass);
    -webkit-backdrop-filter: blur(28px) saturate(1.8);
    backdrop-filter: blur(28px) saturate(1.8);
    box-shadow: var(--glass-rim), var(--glass-drop);
  }

  .l-q {
    margin: 0;
    padding: 18px 0;
    border: 0;
    border-top: 1px solid var(--line);
  }

  .l-q:first-child {
    border-top: 0;
  }

  .l-q-label {
    display: flex;
    align-items: center;
    gap: 12px;
    float: left;
    width: 100%;
    margin-bottom: 14px;
    font-size: 1.12rem;
    font-weight: 500;
    letter-spacing: -0.015em;
    color: var(--fg);
  }

  .l-q-n {
    display: inline-grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.08);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.1);
    font-size: 0.78rem;
    color: var(--fg-2);
  }

  .l-seg--wide {
    clear: both;
    display: flex;
    flex-wrap: wrap;
  }

  .l-seg--wide .l-seg-item {
    flex: 1 1 auto;
    padding: 0 16px;
  }

  @media (max-width: 560px) {
    .l-seg--wide {
      border-radius: 22px;
    }
  }

  /* the pass */
  .l-pass {
    position: relative;
    padding: 26px 28px 28px;
    border-radius: 34px;
    background:
      radial-gradient(120% 80% at 100% 0%, rgb(255 106 61 / 0.22), transparent 60%),
      rgb(30 24 22 / 0.5);
    -webkit-backdrop-filter: blur(32px) saturate(1.9);
    backdrop-filter: blur(32px) saturate(1.9);
    box-shadow: var(--glass-rim), var(--glass-drop);
  }

  .l-pass-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.86rem;
  }

  .l-pass-brand {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 600;
    color: var(--fg);
  }

  .l-pass-status {
    color: var(--fg-3);
  }

  .l-pass-title {
    margin: 22px 0 0;
    font-size: clamp(1.7rem, 2.4vw, 2.2rem);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -0.035em;
    color: var(--fg);
  }

  /* a ticket's tear line */
  .l-pass-tear {
    position: relative;
    margin: 24px -28px 8px;
    height: 0;
    border-top: 1.5px dashed rgb(246 242 236 / 0.22);
  }

  .l-pass-lines {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .l-pass :global(.fit-line) {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 4px 16px;
    align-items: baseline;
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
    animation: l-line 0.55s var(--ease) both;
    animation-delay: calc(var(--n, 0) * 0.07s);
  }

  @keyframes l-line {
    from {
      opacity: 0;
      transform: translateY(6px);
      filter: blur(4px);
    }
  }

  .l-pass :global(.fit-line b) {
    font-weight: 500;
    color: var(--fg);
  }

  .l-pass :global(.fit-line i) {
    font-style: normal;
    color: var(--fg);
    font-variant-numeric: tabular-nums;
  }

  .l-pass :global(.fit-line small) {
    grid-column: 1 / -1;
    font-size: 0.88rem;
    color: var(--fg-3);
  }

  .l-pass :global(.fit-line--free b),
  .l-pass :global(.fit-line--free i) {
    color: var(--ember-soft);
  }

  .l-pass :global(.fit-line--ghost span) {
    display: block;
    height: 10px;
    border-radius: 6px;
    background: rgb(255 255 255 / 0.07);
  }

  .l-pass :global(.fit-line--ghost span:last-child) {
    width: 64px;
  }

  .l-pass-total {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    padding-top: 18px;
    color: var(--fg-3);
    font-size: 0.9rem;
  }

  .l-pass-total[hidden] {
    display: none;
  }

  .l-pass-sum {
    font-size: clamp(1.9rem, 2.8vw, 2.5rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    color: var(--fg);
    font-variant-numeric: tabular-nums;
  }

  .l-pass-verdict {
    margin: 16px 0 0;
    color: var(--fg-2);
    font-size: 0.98rem;
  }

  .l-pass-ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 20px;
    margin-top: 22px;
  }

  .l-pass-ctas[hidden],
  .l-pass-audit[hidden] {
    display: none;
  }

  .l-pass-audit {
    color: var(--fg);
    font-weight: 500;
    font-size: 0.95rem;
    text-decoration: none;
  }

  .l-pass-audit:hover {
    color: var(--ember-soft);
  }

  .l-plan-mini {
    display: none;
  }
</style>
