---
// The close: one question set very large over the brightest light on the page, two ways to
// answer it, then the plain footer.
import { site } from '../../site.config';

interface Props {
  cta?: boolean;
}

const { cta = true } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="l-footer" data-light="1.15 0.5 0.98 0.25">
  {
    cta && (
      <section class="l-wrap l-cta" aria-labelledby="cta-title">
        <p class="l-eyebrow">Work with me</p>
        <h2 id="cta-title" class="l-cta-title">
          Raising in the next six months? <span class="l-dim">Let’s look at your narrative.</span>
        </h2>
        <div class="l-cta-row">
          <p class="l-cta-text">
            Tell me about the company, the round and where the story feels weak. I read every enquiry myself and reply
            within {site.replyTime}.
          </p>
          <div class="l-btns">
            <a href="/work-with-me" class="l-btn l-btn--primary l-btn--lg" data-lens-glass="3" data-cta="Discuss your raise" data-cta-location="footer">
              Discuss your raise
            </a>
            <a href="/work-with-me?type=audit" class="l-btn l-btn--lg" data-lens-glass="5" data-cta="Request a free deck audit" data-cta-location="footer">
              Free deck audit
            </a>
          </div>
        </div>
      </section>
    )
  }

  <div class="l-wrap l-foot">
    <div class="l-foot-about">
      <p class="l-foot-name">{site.name}</p>
      <p>{site.role}. I help pre-seed and seed founders in the US and UK tell a compelling story to investors.</p>
    </div>
    <nav class="l-foot-col" aria-label="Footer">
      <p class="l-eyebrow">Pages</p>
      <ul>
        <li><a href="/services">Services</a></li>
        <li><a href="/work">Work</a></li>
        <li><a href="/about">About</a></li>
        <li><a href="/work-with-me">Work with me</a></li>
      </ul>
    </nav>
    <div class="l-foot-col">
      <p class="l-eyebrow">Elsewhere</p>
      <ul>
        <li><a href={`mailto:${site.email}`} data-contact="email">{site.email}</a></li>
        <li><a href={site.x.url} rel="me noopener" target="_blank" data-contact="x">X {site.x.handle}</a></li>
        <li><a href={site.linkedin} rel="me noopener" target="_blank" data-contact="linkedin">LinkedIn</a></li>
      </ul>
    </div>
    <div class="l-foot-col">
      <p class="l-eyebrow">Also</p>
      <p>I run <a href={site.firm.url} rel="noopener" target="_blank">{site.firm.name}</a>, {site.firm.line}.</p>
    </div>
  </div>
  <div class="l-wrap l-foot-base">
    <span>© {year} {site.name}</span>
    <a href="/privacy">Privacy</a>
  </div>
</footer>
