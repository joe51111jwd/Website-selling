---
// The five slides that decide most first meetings, as a row of glass cards. Each has a segmented
// control: what founders usually write, what an investor hears, and what to write instead. The
// switch is plain radio buttons and CSS (:has), so it works without JavaScript; segments.ts adds
// the liquid thumb.
import { getWork } from '../../lib/content';

const notes = await getWork('analysis');

// what an investor hears, in a sentence, drawn from each analysis
const hears: Record<string, string> = {
  'market-slide': '“If we capture just 1%” tells me you haven’t worked out who buys. That number is the size of the world, not the size of your company.',
  'traction-as-a-rate': 'A total hides the three things I’m looking for: how fast it’s growing, whether people stay, and where they came from.',
  'no-direct-competitors': 'Either there’s no market, or you haven’t looked. Neither is what you meant.',
  'why-now': 'That’s true of every company in the sector, so it tells me nothing about why yours can win now.',
  'the-ask': 'I know the amount. I don’t know what it buys, or what it will prove to the next investor.',
};

const cards = notes
  .filter((n) => n.data.example)
  .map((n) => ({ id: n.id, slide: n.data.example!.slide, before: n.data.example!.before, after: n.data.example!.after, hear: hears[n.id] ?? n.data.dek }));
---

<section class="l-hear" data-light="0.75 0.5 1.0 0.1" aria-labelledby="hear-title">
  <div class="l-wrap l-hear-head">
    <p class="l-eyebrow">Five slides that decide the first meeting</p>
    <h2 id="hear-title" class="l-h2">Read your deck <span class="l-dim">the way an investor does.</span></h2>
    <p class="l-lead">
      Switch each slide between what founders usually write, what the investor actually hears, and the rewrite. The examples are invented; the reasoning is the work.
    </p>
  </div>

  <div class="l-rail" data-rail>
    <ol class="l-rail-track" data-rail-track tabindex="0" aria-label="Five slides, scroll sideways">
      {
        cards.map((c, i) => (
          <li class="l-hcard">
            <div class="l-hcard-top">
              <span class="l-tag">{c.slide}</span>
              <span class="l-hcard-n">
                {String(i + 1).padStart(2, '0')} / {String(cards.length).padStart(2, '0')}
              </span>
            </div>

            <fieldset class="l-seg" data-seg="checked">
              <legend class="sr-only">Show the {c.slide.toLowerCase()} slide as</legend>
              <span class="l-seg-thumb" data-seg-thumb aria-hidden="true" />
              <label class="l-seg-item" data-seg-item>
                <input type="radio" name={`v-${c.id}`} value="write" checked />
                <span>You write</span>
              </label>
              <label class="l-seg-item" data-seg-item>
                <input type="radio" name={`v-${c.id}`} value="hear" />
                <span>They hear</span>
              </label>
              <label class="l-seg-item" data-seg-item>
                <input type="radio" name={`v-${c.id}`} value="instead" />
                <span>Rewrite</span>
              </label>
            </fieldset>

            <div class="l-hcard-body">
              <div class="l-hview l-hview--write">
                <p class="l-hcard-claim l-hcard-claim--weak">“{c.before.headline}”</p>
                <ul class="l-hcard-points">
                  {c.before.points.map((p) => (
                    <li>{p}</li>
                  ))}
                </ul>
              </div>
              <div class="l-hview l-hview--hear">
                <p class="l-hcard-claim l-hcard-claim--hear">{c.hear}</p>
              </div>
              <div class="l-hview l-hview--instead">
                <p class="l-hcard-claim">{c.after.headline}</p>
                <ul class="l-hcard-points">
                  {c.after.points.map((p) => (
                    <li>{p}</li>
                  ))}
                </ul>
              </div>
            </div>

            <a class="l-hcard-more" href={`/work/${c.id}`}>
              Read the analysis <span aria-hidden="true">→</span>
            </a>
          </li>
        ))
      }
    </ol>
    <div class="l-wrap l-rail-bar">
      <span class="l-rail-progress" aria-hidden="true"><span /></span>
      <div class="l-rail-arrows">
        <button type="button" class="l-btn l-rail-arrow" data-dir="-1" aria-label="Previous slide" data-lens-glass="4">←</button>
        <button type="button" class="l-btn l-rail-arrow" data-dir="1" aria-label="Next slide" data-lens-glass="4">→</button>
      </div>
    </div>
  </div>
</section>

<script>
  // The rail: arrows step a card at a time, a bar shows how far along you are, and a mouse can
  // drag it sideways (touch scrolls natively).
  document.querySelectorAll<HTMLElement>('[data-rail]').forEach((rail) => {
    const track = rail.querySelector<HTMLElement>('[data-rail-track]')!;
    const bar = rail.querySelector<HTMLElement>('.l-rail-progress')!;
    const update = () => {
      const max = track.scrollWidth - track.clientWidth;
      bar.style.setProperty('--p', String(max > 0 ? (track.scrollLeft + track.clientWidth) / track.scrollWidth : 1));
    };
    track.addEventListener('scroll', update, { passive: true });
    addEventListener('resize', update);
    update();
    rail.querySelectorAll<HTMLButtonElement>('[data-dir]').forEach((b) =>
      b.addEventListener('click', () => {
        const card = track.querySelector<HTMLElement>('.l-hcard');
        track.scrollBy({ left: Number(b.dataset.dir) * ((card?.offsetWidth ?? 400) + 20), behavior: 'smooth' });
      }),
    );
    let down = false;
    let startX = 0;
    let startLeft = 0;
    let moved = 0;
    track.addEventListener('pointerdown', (e) => {
      if (e.pointerType !== 'mouse' || e.button !== 0 || (e.target as HTMLElement).closest('label, a, button')) return;
      down = true;
      moved = 0;
      startX = e.clientX;
      startLeft = track.scrollLeft;
    });
    addEventListener('pointermove', (e) => {
      if (!down) return;
      moved = Math.abs(e.clientX - startX);
      if (moved > 4) {
        rail.classList.add('dragging');
        track.scrollLeft = startLeft - (e.clientX - startX);
      }
    });
    addEventListener('pointerup', () => {
      if (!down) return;
      down = false;
      rail.classList.remove('dragging');
    });
  });
</script>

<style>
  .l-hear {
    padding-block: clamp(60px, 8vw, 120px);
  }

  .l-hear-head {
    display: grid;
    gap: 22px;
  }

  .l-hear-head .l-h2 {
    max-width: 12em;
  }

  .l-rail {
    margin-top: clamp(40px, 5vw, 64px);
  }

  .l-rail-track {
    list-style: none;
    margin: 0;
    display: flex;
    gap: 20px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gutter);
    padding: 10px var(--gutter) 30px;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }

  @media (min-width: 1360px) {
    .l-rail-track {
      padding-inline: calc((100vw - var(--wrap)) / 2 + var(--gutter));
      scroll-padding-inline: calc((100vw - var(--wrap)) / 2 + var(--gutter));
    }
  }

  .l-rail-track::-webkit-scrollbar {
    display: none;
  }

  :global(.dragging) .l-rail-track {
    scroll-snap-type: none;
    cursor: grabbing;
  }

  .l-hcard {
    position: relative;
    flex: 0 0 min(86vw, 520px);
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    gap: 22px;
    min-height: 540px;
    padding: 26px;
    border-radius: 34px;
    background: var(--glass);
    -webkit-backdrop-filter: blur(28px) saturate(1.8);
    backdrop-filter: blur(28px) saturate(1.8);
    box-shadow: var(--glass-rim), var(--glass-drop);
  }

  .l-hcard-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .l-hcard-n {
    font-size: 0.82rem;
    color: var(--fg-3);
    font-variant-numeric: tabular-nums;
  }

  /* the three views */
  .l-hcard-body {
    position: relative;
    flex: 1;
  }

  .l-hview {
    display: none;
    animation: l-view 0.55s var(--ease) both;
  }

  @keyframes l-view {
    from {
      opacity: 0;
      transform: translateY(8px);
      filter: blur(6px);
    }
  }

  .l-hcard:has(input[value='write']:checked) .l-hview--write,
  .l-hcard:has(input[value='hear']:checked) .l-hview--hear,
  .l-hcard:has(input[value='instead']:checked) .l-hview--instead {
    display: block;
  }

  .l-hcard-claim {
    margin: 0;
    font-size: clamp(1.7rem, 2.6vw, 2.35rem);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -0.035em;
    color: var(--fg);
    text-wrap: balance;
  }

  .l-hcard-claim--weak {
    color: rgb(246 242 236 / 0.62);
  }

  .l-hcard-claim--hear {
    color: var(--ember-soft);
    font-weight: 500;
    letter-spacing: -0.025em;
  }

  .l-hcard-points {
    list-style: none;
    margin: 22px 0 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }

  .l-hcard-points li {
    position: relative;
    padding: 10px 0 0 22px;
    border-top: 1px solid var(--line);
    font-size: 0.98rem;
    line-height: 1.45;
    color: var(--fg-2);
  }

  .l-hcard-points li::before {
    content: '';
    position: absolute;
    left: 2px;
    top: 19px;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--fg-3);
  }

  .l-hview--instead .l-hcard-points li::before {
    background: var(--ember);
    box-shadow: 0 0 8px rgb(255 106 61 / 0.7);
  }

  .l-hcard-more {
    align-self: flex-start;
    color: var(--fg);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.95rem;
  }

  .l-hcard-more:hover {
    color: var(--ember-soft);
  }

  .l-rail-bar {
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .l-rail-progress {
    position: relative;
    flex: 1;
    height: 2px;
    background: var(--line);
    border-radius: 2px;
    overflow: hidden;
  }

  .l-rail-progress span {
    position: absolute;
    inset: 0;
    background: var(--fg);
    transform-origin: left;
    transform: scaleX(var(--p, 0.3));
    transition: transform 0.3s ease;
  }

  .l-rail-arrows {
    display: flex;
    gap: 10px;
  }

  .l-rail-arrow {
    width: 48px;
    padding: 0;
    font-size: 1.1rem;
  }
</style>
